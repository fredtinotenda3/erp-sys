# Copy to .env.test. The test suite reads ONLY this file (never .env) so a test run can
# never touch the database you demo from. Defaults match docker-compose.test.yml.
#
# Roles: mops_migrator owns the schema (migrations only); mops_runtime is the
# least-privilege role the app code (and therefore the tests) connect as.
# They are created by `npm run test:db:setup`.

MIGRATION_DATABASE_URL="postgresql://mops_migrator:test-migrator-pw@localhost:54329/operis_test"
RUNTIME_DATABASE_URL="postgresql://mops_runtime:test-runtime-pw@localhost:54329/operis_test"

# Superuser of the throwaway server. Used ONLY by scripts/test-db-setup.mjs.
TEST_DB_ADMIN_URL="postgresql://postgres:devpassword@localhost:54329/postgres"

SESSION_SECRET="test-only-secret-not-used-anywhere-else-0123456789abcdef0123456789abcdef"
DEFAULT_BASE_CURRENCY="USD"

# Optional tuning (defaults shown).
# TEST_TIMEOUT_MS=30000
# TEST_HOOK_TIMEOUT_MS=60000
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=15000

# Only if you deliberately point the suite at a non-local database (e.g. a dedicated Neon
# branch). Expect it to be 10-50x slower and to leave test organizations behind.
# ALLOW_REMOTE_TEST_DB=1
