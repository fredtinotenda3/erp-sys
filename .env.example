# Operis ERP — application environment template.
#
# Copy to `.env` and fill in real values for YOUR development/demo database
# (Neon or local Postgres). `.env` is git-ignored; this template is not
# (see .gitignore's exception for .env.example / .env.test.example).
#
# This is the file the RUNNING APPLICATION reads (next dev / next start /
# scripts that aren't the test suite). The automated test suite reads
# .env.test instead, never this file — see .env.test.example and
# docs/TESTING.md for why they're kept separate.
#
# Referenced by docs/SETUP_COMMANDS.md section 4 and README-FIXES.txt.

# --- Database ---------------------------------------------------------------
# Two roles, least-privilege split (docs/db-roles-and-security.sql, ARCHITECTURE.md
# Phase 0 Addendum revision #6): mops_migrator owns the schema (DDL only, used by
# the Prisma CLI via prisma.config.ts); mops_runtime is what the running app
# connects as, and cannot write stock_balance directly (the DB trigger does that).
# Never swap these — the app must never hold the migrator's DDL privileges.
MIGRATION_DATABASE_URL="postgresql://mops_migrator:change-me-migrator-password@localhost:5432/mops_dev?schema=public"
RUNTIME_DATABASE_URL="postgresql://mops_runtime:change-me-runtime-password@localhost:5432/mops_dev?schema=public"

# Connection pool tuning for src/server/shared/db.ts. Defaults are remote-safe
# (Neon, possibly waking from auto-suspend); raise DB_CONNECT_TIMEOUT_MS further
# if you see "timeout exceeded when trying to connect" on first load after idle.
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=15000

# --- Runtime mode -------------------------------------------------------------
NODE_ENV=development

# Base URL used to build links in emails/dev-outbox output (password reset).
APP_BASE_URL=http://localhost:3000

# --- Organization bootstrap (src/server/modules/iam/bootstrap-gate.ts) -------
# In development the bootstrap endpoint (POST /api/v1/organizations/bootstrap,
# creates the first org + OWNER_ADMIN) is open. In production it is OFF unless
# this is set, and then every request must present it as the x-bootstrap-token
# header. Generate a real secret before ever setting NODE_ENV=production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ORG_BOOTSTRAP_TOKEN=

# --- Password reset delivery (src/server/modules/iam/password-service.ts) ---
# Development-only fallback: with NODE_ENV=development AND this set to 1, the
# reset link is logged to the server console/dev outbox instead of emailed —
# there is no mail transport wired yet (see docs/PRODUCTION_READINESS.md).
# Never set this in production; no effect there regardless.
PASSWORD_RESET_DEV_OUTBOX=1

# --- Client IP for rate limiting (src/server/shared/http.ts) -----------------
# On Vercel this is unnecessary (the platform's own forwarding headers are
# used automatically). Behind another reverse proxy, set this to the single
# header YOUR proxy overwrites on every request (e.g. x-real-ip behind nginx
# configured with `proxy_set_header X-Real-IP $remote_addr`, or
# cf-connecting-ip behind Cloudflare). Never x-forwarded-for — proxies APPEND
# to it, so its first entry is caller-chosen, not proxy-verified.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
