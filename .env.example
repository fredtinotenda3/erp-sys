# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Two separate connection strings, two separate DB roles (see
# docs/db-roles-and-security.sql and ARCHITECTURE.md Phase 0 Addendum #6).
# These are NOT interchangeable — using RUNTIME_DATABASE_URL for migrations
# will fail (mops_runtime doesn't own the schema); using MIGRATION_DATABASE_URL
# for the running app would hand the app superuser-like DDL rights it should
# never have.
# ---------------------------------------------------------------------------

# mops_migrator — schema owner. Used ONLY by `npx prisma migrate *` and by
# `prisma.config.ts`. The running application never opens a connection with
# this URL.
MIGRATION_DATABASE_URL="postgresql://mops_migrator:change-me-migrator-password@localhost:5432/mops_dev?schema=public"

# mops_runtime — least-privilege application role. Used by src/server/shared/db.ts
# via @prisma/adapter-pg. No DDL rights; no write access to stock_movement,
# audit_log, exchange_rate, job_cost_actual (insert-only) or stock_balance
# (read-only) — see docs/db-roles-and-security.sql Stage 3 for the exact grants.
RUNTIME_DATABASE_URL="postgresql://mops_runtime:change-me-runtime-password@localhost:5432/mops_dev?schema=public"

# Session cookie signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-real-random-64-char-hex-string"

# Org default base currency on seed (see ARCHITECTURE.md Section 3.2 / Section 15 Q3)
DEFAULT_BASE_CURRENCY="USD"

# ---------------------------------------------------------------------------
# Account security (see docs/PRODUCTION_READINESS.md)
# ---------------------------------------------------------------------------

# Public base URL, used to build password-reset links. Production: your https:// origin.
APP_BASE_URL=http://localhost:3000

# Production only, and only WHILE onboarding a new organization: a long random value that must be sent
# as the `x-bootstrap-token` header to POST /api/v1/organizations/bootstrap. If unset in production the
# endpoint is disabled (404). Unset it again afterwards.
ORG_BOOTSTRAP_TOKEN=

# Development only: set to 1 (with NODE_ENV=development) to write password-reset links to
# .dev-outbox/password-reset.log instead of sending email. Ignored in production.
PASSWORD_RESET_DEV_OUTBOX=

# Client-address trust for rate limiting (see docs/PRODUCTION_READINESS.md). Vercel needs nothing.
# Self-hosted: the NAME of one header your reverse proxy overwrites on every request
# (e.g. x-real-ip, cf-connecting-ip). x-forwarded-for is not accepted. Leave empty to disable
# per-address limits (per-account limits still apply).
TRUSTED_CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Connection pool (src/server/shared/db.ts) — all optional
# ---------------------------------------------------------------------------
# Remote databases (Neon, etc.): use sslmode=verify-full explicitly. "require" is currently an alias for
# it in node-postgres and will change meaning in pg v9. Keep the pooled (-pooler) host for the app.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000
#
# The automated tests do NOT read this file. They use .env.test (see .env.test.example, docs/TESTING.md).
