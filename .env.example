# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Two separate connection strings, two separate DB roles (see
# docs/db-roles-and-security.sql and ARCHITECTURE.md Phase 0 Addendum #6).
# These are NOT interchangeable — using RUNTIME_DATABASE_URL for migrations
# will fail (mops_runtime doesn't own the schema); using MIGRATION_DATABASE_URL
# for the running app would hand the app superuser-like DDL rights it should
# never have.
# ---------------------------------------------------------------------------

# mops_migrator — schema owner. Used ONLY by `npx prisma migrate *` and by
# `prisma.config.ts`. The running application never opens a connection with
# this URL.
MIGRATION_DATABASE_URL="postgresql://mops_migrator:change-me-migrator-password@localhost:5432/mops_dev?schema=public"

# mops_runtime — least-privilege application role. Used by src/server/shared/db.ts
# via @prisma/adapter-pg. No DDL rights; no write access to stock_movement,
# audit_log, exchange_rate, job_cost_actual (insert-only) or stock_balance
# (read-only) — see docs/db-roles-and-security.sql Stage 3 for the exact grants.
RUNTIME_DATABASE_URL="postgresql://mops_runtime:change-me-runtime-password@localhost:5432/mops_dev?schema=public"

# Session cookie signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-real-random-64-char-hex-string"

# Org default base currency on seed (see ARCHITECTURE.md Section 3.2 / Section 15 Q3)
DEFAULT_BASE_CURRENCY="USD"
