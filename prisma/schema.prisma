// ============================================================================
// Manufacturing Operations Intelligence Platform — Prisma schema
// Source of truth once migrations run. See ARCHITECTURE.md "Phase 0 Addendum".
//
// Prisma ORM 7: "prisma-client" generator with explicit output path and a
// driver adapter (@prisma/adapter-pg) at runtime — see src/server/shared/db.ts
// and prisma.config.ts. Application code imports from "<output>/client".
//
// All UUID primary keys use @default(dbgenerated("gen_random_uuid()")) so
// Postgres itself owns the default (matches docs/schema.sql).
//
// NOT expressible in this file (hand-written SQL migrations):
//   1. job_cost_actual.gross_profit — Postgres GENERATED column, deliberately
//      not a Prisma field (read via $queryRaw).
//   2. app_user `email = lower(email)` CHECK constraint.
//   3. Partial unique index: one ACTIVE BillOfMaterial per product.
//   4. The stock_balance-maintaining SECURITY DEFINER trigger with
//      negative-stock / currency-mixing / branch-consistency checks.
//   5. prevent_mutation immutability triggers (stock_movement, audit_log,
//      exchange_rate, job_cost_actual, and — as of migration
//      20261104110000_purchasing_and_receiving — goods_receipt and
//      goods_receipt_line) — see docs/db-roles-and-security.sql.
//   6. job_material_cost_live / job_labour_cost_live views ($queryRaw only).
//   7. goods_receipt_line CHECK constraints: quantities non-negative, and
//      accepted_qty + rejected_qty = received_qty (migration
//      20261104110000_purchasing_and_receiving).
//   8. material_lot.quantity_received > 0 CHECK, and a column-level GRANT
//      restricting mops_runtime's UPDATE on material_lot to (status,
//      expiry_date) only — every other column is set once at creation and
//      never updated (same migration as #7).
//
// Fields reorderThreshold (Item) and staleOrderThresholdDays (Organization)
// were added by migration 20261007090000 and are mirrored here.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Migrate URL lives in prisma.config.ts (mops_migrator only). The running
  // app uses RUNTIME_DATABASE_URL (mops_runtime) via src/server/shared/db.ts.
}

// ---------------------------------------------------------------------------
// IAM / TENANCY
// ---------------------------------------------------------------------------

enum Role {
  OWNER_ADMIN
  OPERATIONS_MANAGER
  PRODUCTION_MANAGER
  INVENTORY_MANAGER
  PRODUCTION_OPERATOR
  FINANCE_MANAGER
  VIEWER
}

// Milestone 5 (Configurable Industry Architecture). The mandate's 7-profile
// list. "plastics" is the first, and so far only, profile with any actually
// implemented behaviour behind it (Milestone 6); the other 5 exist here so
// an organisation's profile selection is a real, typed value from day one --
// not a sign that their workflows are implemented (see
// industry-profile-service.ts's PROFILE_REGISTRY, which is the actual
// source of truth for what each profile supports today).
enum IndustryProfile {
  general
  plastics
  food_beverage
  metal_fabrication
  textile_garment
  furniture_woodworking
  packaging_printing
}

model Organization {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  slug                    String   @unique // login handle; format CHECK is manual SQL (migration 20261008100000)
  baseCurrency            String   @map("base_currency") @db.Char(3)
  currency                Currency @relation(fields: [baseCurrency], references: [code])
  staleOrderThresholdDays Int      @default(3) @map("stale_order_threshold_days")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Milestone 5 additions. industryProfile defaults to "general" so every
  // existing/new organization behaves exactly as before until an
  // OWNER_ADMIN deliberately changes it (industry-profile-service.ts). A
  // Json array of module-key strings, not a Postgres native array, to match
  // this schema's one existing precedent for a small structured-but-dynamic
  // value (AuditLog.beforeValue/afterValue) rather than introducing the
  // first scalar array column in the project; validated against the
  // selected profile's PROFILE_REGISTRY entry at the service layer, and
  // constrained at the DB level to always be a JSON array (see migration).
  industryProfile       IndustryProfile @default(general) @map("industry_profile")
  industryProfileModules Json           @default("[]") @map("industry_profile_modules")

  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]
  items     Item[]
  customers Customer[]
  suppliers Supplier[]
  jobCounter JobNumberCounter?
  exchangeRates ExchangeRate[]

  @@map("organization")
}

model Branch {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  userAccess     UserBranchAccess[]
  warehouses     Warehouse[]
  productionJobs ProductionJob[]
  salesOrders    SalesOrder[]
  auditLogs      AuditLog[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  finishedGoodsBatches FinishedGoodsBatch[]
  dispatches           Dispatch[]
  // Milestone 4 additions
  workCentres          WorkCentre[]
  // Milestone 6 additions
  moulds               Mould[]

  @@unique([orgId, name])
  @@unique([orgId, id]) // lets children do composite FK (orgId, branchId) -> Branch(orgId, id)
  @@map("branch")
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])
  email        String // lowercased by the application; DB-enforced via manual CHECK
  passwordHash String       @map("password_hash")
  fullName     String       @map("full_name")
  role         Role
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  branchAccessGranted UserBranchAccess[] @relation("accessForUser")
  branchAccessGivenBy UserBranchAccess[] @relation("grantedByUser")
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  auditActions        AuditLog[]

  @@unique([orgId, email])
  @@unique([orgId, id])
  @@map("app_user")
}

model UserBranchAccess {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("accessForUser", fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Cascade)
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid
  granter   User?    @relation("grantedByUser", fields: [grantedBy], references: [id])

  @@id([userId, branchId])
  @@map("user_branch_access")
}

// One-time password-reset credential. Only the SHA-256 of the emailed token is stored, so reading
// this table never yields a usable token. Single use (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")

  @@index([userId])
  @@map("password_reset_token")
}

// Fixed-window counters for login / reset throttling. `key` is a SHA-256 of "<scope>:<identifier>",
// so neither emails nor IP addresses are stored in the clear.
model AuthThrottle {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("auth_throttle")
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  @@map("user_session")
}

enum AuditAction {
  create
  update
  delete
  transition
  grant
  revoke
}

model AuditLog {
  id          BigInt       @id @default(autoincrement())
  orgId       String       @map("org_id") @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id])
  branchId    String?      @map("branch_id") @db.Uuid
  branch      Branch?      @relation(fields: [orgId, branchId], references: [orgId, id])
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actor       User?        @relation(fields: [orgId, actorUserId], references: [orgId, id])
  entityType  String       @map("entity_type") // intentionally free text
  entityId    String       @map("entity_id") @db.Uuid
  action      AuditAction
  beforeValue Json?        @map("before_value")
  afterValue  Json?        @map("after_value")
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// CURRENCY — platform-wide reference data, intentionally NOT org-scoped
// ---------------------------------------------------------------------------

enum RateSource {
  RBZ_OFFICIAL
  MARKET
  MANUAL
}

model Currency {
  code     String @id @db.Char(3)
  name     String
  decimals Int    @default(2)

  organizations        Organization[]
  exchangeRatesAsBase  ExchangeRate[] @relation("baseCurrency")
  exchangeRatesAsQuote ExchangeRate[] @relation("quoteCurrency")

  @@map("currency")
}

// Org-scoped: a rate is something an organization's finance team recorded and
// stands behind (source RBZ_OFFICIAL / MARKET / MANUAL). Rates are NOT shared
// between tenants -- one org's rate must never change another org's figures.
model ExchangeRate {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  org           Organization @relation(fields: [orgId], references: [id])
  baseCurrency  String     @map("base_currency") @db.Char(3)
  base          Currency   @relation("baseCurrency", fields: [baseCurrency], references: [code])
  quoteCurrency String     @map("quote_currency") @db.Char(3)
  quote         Currency   @relation("quoteCurrency", fields: [quoteCurrency], references: [code])
  rate          Decimal    @db.Decimal(18, 8)
  asOfDate      DateTime   @map("as_of_date") @db.Date
  source        RateSource
  recordedById  String?    @map("recorded_by") @db.Uuid
  recordedAt    DateTime   @default(now()) @map("recorded_at")

  @@index([orgId, baseCurrency, quoteCurrency, source, asOfDate])
  @@map("exchange_rate")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

enum ItemType {
  raw_material
  consumable
  spare_part
  finished_good
  wip
}

model Item {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String       @map("org_id") @db.Uuid
  org                  Organization @relation(fields: [orgId], references: [id])
  sku                  String
  name                 String
  description          String?
  uom                  String
  itemType             ItemType     @map("item_type")
  isSellable           Boolean      @default(false) @map("is_sellable")
  sellingPrice         Decimal?     @map("selling_price") @db.Decimal(14, 4)
  sellingPriceCurrency String?      @map("selling_price_currency") @db.Char(3)
  standardCost         Decimal?     @map("standard_cost") @db.Decimal(14, 4)
  standardCostCurrency String?      @map("standard_cost_currency") @db.Char(3)
  reorderThreshold     Decimal?     @map("reorder_threshold") @db.Decimal(14, 4)
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  bomsAsProduct        BillOfMaterial[]          @relation("productItem")
  bomLinesAsMaterial   BomLine[]                 @relation("materialItem")
  salesOrderLines      SalesOrderLine[]
  productionJobs       ProductionJob[]
  materialRequirements MaterialRequirement[]
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  stageTemplates       ProductionStageTemplate[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  materialLots         MaterialLot[]
  finishedGoodsBatches FinishedGoodsBatch[]
  fgBatchMaterialLines FgBatchMaterialLot[]
  // Milestone 4 additions
  inspectionPlans      InspectionPlan[]
  // Milestone 6 additions -- both optional 1:1s, only ever created when the
  // organization is on the plastics profile (enforced in
  // plastics-item-service.ts, not by a column constraint, for the same
  // reason setPlasticsProductSpec/setPlasticsMaterialAttributes themselves
  // check the profile rather than a DB trigger: switching an organization
  // OFF the plastics profile later must not corrupt or hide this historical
  // data, so nothing here is allowed to depend on the org's CURRENT profile
  // to remain valid).
  plasticsMaterialAttributes PlasticsMaterialAttributes?
  plasticsProductSpec        PlasticsProductSpec?
  compatibleMoulds           Mould[]

  @@unique([orgId, sku])
  @@unique([orgId, id])
  @@map("item")
}

enum BomStatus {
  draft
  active
  superseded
}

model BillOfMaterial {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  productItemId String    @map("product_item_id") @db.Uuid
  productItem   Item      @relation("productItem", fields: [orgId, productItemId], references: [orgId, id])
  version       Int
  status        BomStatus @default(draft) // partial unique index enforces one ACTIVE per product (manual SQL)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  // Milestone 4: informational planning window only. Nothing auto-supersedes
  // or auto-activates a BOM version on this date -- activateBomVersion
  // (bom-service.ts) remains the only way a version becomes active, exactly
  // as before. This just lets a plan show "this version was meant to retire
  // on <date>" without the system silently acting on it.
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  lines          BomLine[]
  productionJobs ProductionJob[]

  @@unique([productItemId, version])
  @@unique([orgId, id])
  @@map("bill_of_material")
}

model BomLine {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  bomId          String         @map("bom_id") @db.Uuid
  bom            BillOfMaterial @relation(fields: [orgId, bomId], references: [orgId, id], onDelete: Cascade)
  materialItemId String         @map("material_item_id") @db.Uuid
  materialItem   Item           @relation("materialItem", fields: [orgId, materialItemId], references: [orgId, id])
  quantity       Decimal        @db.Decimal(14, 4)
  uom            String
  // Milestone 4. Both null by default = today's behaviour, unchanged: a BOM
  // line with no explicit scrap/yield affects nothing new. expectedScrapPct
  // (0-100), when set, is the ONLY one of the two that changes computed
  // behaviour -- createJob (job-service.ts) multiplies the snapshotted
  // expectedQty by (1 + expectedScrapPct/100) so the job's material
  // requirement already allows for expected scrap. expectedYieldPct is
  // informational only in this milestone (surfaced on the BOM editor and in
  // reports) -- it does NOT feed into expectedQty, to avoid double-counting
  // against expectedScrapPct and to avoid guessing which of several possible
  // yield formulas (finished-unit yield vs. material yield) the org means
  // without that being specified. Revisit once a concrete yield-reporting
  // requirement names the formula.
  expectedScrapPct Decimal? @map("expected_scrap_pct") @db.Decimal(5, 2)
  expectedYieldPct Decimal? @map("expected_yield_pct") @db.Decimal(5, 2)

  @@index([bomId])
  @@map("bom_line")
}

// ---------------------------------------------------------------------------
// SALES — Customer is org-scoped (Q5 = org-wide)
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  inactive
}

model Customer {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  org       Organization   @relation(fields: [orgId], references: [id])
  name      String
  contact   String?
  address   String?
  status    CustomerStatus @default(active)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  salesOrders    SalesOrder[]
  productionJobs ProductionJob[]

  @@unique([orgId, id])
  @@map("customer")
}

// ---------------------------------------------------------------------------
// SUPPLIERS — first milestone of the shared-core build-out (see
// ARCHITECTURE.md's new "Shared core before industry layer" sequencing note).
// Deliberately shaped identically to Customer: org-wide master data (a vendor
// relationship isn't a branch concept — the same supplier can ship to any of
// an org's branches), no hard delete, lifecycle via `status`, no uniqueness
// constraint on name for the same reason Customer has none (two legitimate
// suppliers can share a trading name; supplier-service.test.ts asserts this
// explicitly, same as customer-service.test.ts does).
//
// Fields are intentionally minimal (name/contact/address/notes/status) —
// the same conservative slice Customer shipped with. Purchasing/PO (the next
// milestone in Stanley's ordered list) will likely need supplier-specific
// fields this slice does NOT have: payment terms, lead time, currency,
// tax/registration number, bank details. Not adding them speculatively here
// — flag when Purchasing starts whether they belong on Supplier directly or
// on the PO relationship itself.
// ---------------------------------------------------------------------------

enum SupplierStatus {
  active
  inactive
}

model Supplier {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  org       Organization   @relation(fields: [orgId], references: [id])
  name      String
  contact   String?
  address   String?
  status    SupplierStatus @default(active)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  materialLots   MaterialLot[]

  @@unique([orgId, id])
  @@map("supplier")
}

// ---------------------------------------------------------------------------
// PURCHASING — second milestone of the shared-core build-out, after Suppliers
// (ARCHITECTURE.md's "shared core before industry layer" sequencing note).
//
// Branch-scoped, not org-wide like Supplier/Customer: a PO is placed FOR
// delivery into one branch's warehouses (mirrors SalesOrder's branchId for
// the symmetric reason -- a sale ships FROM a branch, a purchase arrives
// INTO one). Numbering follows sales-order-service.ts's exact pattern
// (advisory xact lock + MAX(substring)+1 inside the create transaction) --
// no separate counter table, same choice SalesOrder made and ProductionJob
// didn't; not duplicating that decision rationale here, see that file.
//
// Status lifecycle (every value is a genuine business state with a defined
// transition, not speculative):
//   draft               -> lines are mutable; the only state that can be edited freely.
//   confirmed           -> committed to the supplier; lines frozen. Mirrors
//                          SalesOrder's confirm step and -- deliberately --
//                          reuses it as the one approval gate rather than
//                          inventing a separate multi-step chain nothing
//                          else in this codebase has (see
//                          purchase_order:confirm's capability grant below
//                          for the segregation-of-duties reasoning).
//   partially_received  -> at least one GoodsReceipt posted, outstanding qty > 0
//                          on at least one line. Set by the goods-receiving
//                          service (next milestone), never written directly here.
//   received            -> every line's outstanding qty is 0. Also set by
//                          goods-receiving, not here.
//   closed              -> manually closed after receiving is done (e.g. the
//                          supplier will never deliver the remainder) -- a
//                          deliberate terminal state distinct from "received"
//                          so a report can tell "fully delivered" apart from
//                          "we stopped waiting."
//   cancelled           -> draft or confirmed only, and only before any
//                          receipt exists (mirrors SalesOrder's "cancel
//                          blocked by live jobs" rule: cancel blocked by any
//                          real downstream activity).
//
enum PurchaseOrderStatus {
  draft
  confirmed
  partially_received
  received
  closed
  cancelled
}

// Outstanding/received quantity is deliberately NOT a stored column on
// PurchaseOrderLine -- it is computed by summing GoodsReceiptLine.acceptedQty
// (same "no duplicate source of truth" principle as StockBalance being
// trigger-derived from StockMovement, and the same choice this codebase
// already made for "why is stock what it is" -- see stock-service.ts's
// header comment). A denormalized running total would need its own
// consistency mechanism (trigger or transaction discipline) for a number
// that's already cheap to derive from the ledger of receipts.
model PurchaseOrder {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String              @map("org_id") @db.Uuid
  branchId              String              @map("branch_id") @db.Uuid
  branch                Branch              @relation(fields: [orgId, branchId], references: [orgId, id])
  poNumber              String              @map("po_number")
  supplierId            String              @map("supplier_id") @db.Uuid
  supplier              Supplier            @relation(fields: [orgId, supplierId], references: [orgId, id])
  status                PurchaseOrderStatus @default(draft)
  currency              String              @db.Char(3)
  requestedDeliveryDate DateTime?           @map("requested_delivery_date") @db.Date
  // Free-text reference to the supplier's own quote/order number -- not
  // validated against anything, same treatment as every other free-text
  // reference field in this codebase (e.g. StockMovement.reason).
  supplierReference String?  @map("supplier_reference")
  notes             String?
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([orgId, poNumber])
  @@unique([orgId, id])
  @@index([branchId, status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  poId      String        @map("po_id") @db.Uuid
  po        PurchaseOrder @relation(fields: [orgId, poId], references: [orgId, id], onDelete: Cascade)
  itemId    String        @map("item_id") @db.Uuid
  item      Item          @relation(fields: [orgId, itemId], references: [orgId, id])
  quantity  Decimal       @db.Decimal(14, 4)
  // Snapshot of the ordering unit at the time the line was written, same
  // convention as BomLine.uom / MaterialRequirement.uom -- never silently
  // re-derived from item.uom, which could change after the PO is placed.
  uom       String
  unitPrice Decimal       @map("unit_price") @db.Decimal(14, 4)
  currency  String        @db.Char(3)

  goodsReceiptLines GoodsReceiptLine[]

  @@unique([orgId, id])
  @@index([poId])
  @@map("purchase_order_line")
}

// ---------------------------------------------------------------------------
// GOODS RECEIVING — third milestone of the shared-core build-out, built
// alongside Purchasing rather than after it: a PO's "outstanding quantity"
// (section 5B requirement #17) has no referent until receipts exist, so the
// two were designed as one schema change (see IMPLEMENTATION_MANIFEST.md for
// why this reorders the mandate's own step 4/5 split without changing what
// either milestone delivers).
//
// One GoodsReceipt (header: which delivery, when, against which PO) has many
// GoodsReceiptLine rows (one per PO line received on that delivery). A single
// PO can have many receipts (partial deliveries -- requirement #18) and a
// single receipt only ever covers one PO (a delivery note that covers two
// POs is recorded as two receipts, same as a single delivery truck with two
// invoices -- keeps "which PO does this receipt close against" unambiguous).
//
// acceptedQty/rejectedQty/rejectReason mirrors QualityRecord's existing
// produced/accepted/rejected shape exactly (service layer enforces
// accepted + rejected = received, same invariant quality-service.ts already
// enforces for production inspections) -- reusing RejectReason rather than
// inventing a parallel enum for the same reason BomLine.uom etc. reuse
// existing shapes: one vocabulary, not two that can drift apart.
//
// unitCost/currency are NOT accepted from the caller -- the service derives
// them from the PO line's own unitPrice/currency (ARCHITECTURE.md's
// standing rule: never trust a client-supplied cost; see
// purchase-order-service.ts / goods-receipt-service.ts). This is receiving
// cost, which may differ from an eventual supplier invoice -- invoice
// matching is accounting/AP territory, out of scope here (FEATURE_AUDIT_MATRIX.md
// #21, already flagged as a pending decision, not reopened by this milestone).
model GoodsReceipt {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  poId              String        @map("po_id") @db.Uuid
  po                PurchaseOrder @relation(fields: [orgId, poId], references: [orgId, id])
  branchId          String        @map("branch_id") @db.Uuid
  branch            Branch        @relation(fields: [orgId, branchId], references: [orgId, id])
  deliveryReference String?       @map("delivery_reference")
  receivedAt        DateTime      @map("received_at")
  notes             String?
  // Idempotency key for the WHOLE submission (one receiving event, however
  // many lines) -- same role StockMovement.clientRequestId plays per
  // movement, but at the header level here: a retried "post this delivery"
  // request must not re-run the per-line loop (and therefore never calls
  // postMovement twice), not merely avoid a duplicate header row. Individual
  // StockMovement/MaterialLot rows created by one receipt get their own
  // fresh, server-generated ids -- they don't need their own idempotency key
  // because the header check already prevents the creating code from running
  // twice for the same logical request.
  clientRequestId String?  @map("client_request_id") @db.Uuid
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  lines GoodsReceiptLine[]

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@index([poId])
  @@index([branchId, receivedAt])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  receiptId    String            @map("receipt_id") @db.Uuid
  receipt      GoodsReceipt      @relation(fields: [orgId, receiptId], references: [orgId, id], onDelete: Cascade)
  poLineId     String            @map("po_line_id") @db.Uuid
  poLine       PurchaseOrderLine @relation(fields: [orgId, poLineId], references: [orgId, id])
  itemId       String            @map("item_id") @db.Uuid
  item         Item              @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId  String            @map("warehouse_id") @db.Uuid
  warehouse    Warehouse         @relation(fields: [orgId, warehouseId], references: [orgId, id])
  receivedQty  Decimal           @map("received_qty") @db.Decimal(14, 4)
  acceptedQty  Decimal           @map("accepted_qty") @db.Decimal(14, 4)
  rejectedQty  Decimal           @map("rejected_qty") @db.Decimal(14, 4)
  rejectReason RejectReason?     @map("reject_reason")
  // Derived from the PO line at receipt time, never client-supplied -- see
  // the model block comment above.
  unitCost  Decimal  @map("unit_cost") @db.Decimal(14, 4)
  currency  String   @db.Char(3)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  lot MaterialLot?

  @@unique([orgId, id])
  @@index([poLineId])
  @@index([receiptId])
  @@map("goods_receipt_line")
}

// ---------------------------------------------------------------------------
// LOT TRACEABILITY -- one MaterialLot per accepted GoodsReceiptLine, created
// automatically and unconditionally in the same transaction as the receipt
// (section 5F: "do not introduce lot tracking as disconnected metadata"). A
// line with acceptedQty = 0 (fully rejected) creates no lot -- there is
// nothing to trace into inventory.
//
// CONSUMPTION (as of migration 20261105120000_lot_consumption_and_traceability,
// "Phase One -- complete lot traceability"): wiring material issue/return to
// draw from and credit back to a specific lot is now built -- see
// LotConsumption below and inventory/material-issue-service.ts. Finished-
// goods batches and dispatch/customer traceability (the mandate's remaining
// forward-chain arrows) are still the NEXT milestone -- see
// IMPLEMENTATION_MANIFEST.md "Known limitations".
//
// quantityReceived is the original accepted quantity (or, for a lot spawned
// by a quarantine-flagged return -- see sourceReturnOfLotId below -- the
// returned quantity), immutable. How much of the lot remains is computed by
// summing LotConsumption rows against it, not stored here -- same "no
// duplicate source of truth" principle as StockBalance being trigger-derived
// from StockMovement: remaining = quantityReceived - SUM(LotConsumption.quantity)
// (LotConsumption.quantity is itself signed: positive = drawn from the lot,
// negative = returned to it -- see that model's comment).
//
// receiptLineId is now NULLABLE: a lot spawned by a return that needs
// inspection (see sourceReturnOfLotId) has no originating GoodsReceiptLine --
// it originates from a ProductionJob's returned material instead. Exactly
// one of (receiptLineId) or (sourceReturnOfLotId + sourceReturnJobId +
// sourceReturnMovementId) is set for any given lot; which one tells you
// whether this lot's lineage starts at a supplier delivery or at a
// production return. Not enforced as a DB CHECK (would need an OR of two
// multi-column null-groups) -- enforced by the two call sites that create a
// MaterialLot (goods-receipt-service.ts, material-issue-service.ts) never
// setting both, verified by this milestone's tests.
enum MaterialLotStatus {
  active
  quarantined
  expired
}

model MaterialLot {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  lotNumber      String           @map("lot_number")
  itemId         String           @map("item_id") @db.Uuid
  item           Item             @relation(fields: [orgId, itemId], references: [orgId, id])
  // Nullable as of Milestone 6 (Plastics Manufacturing Vertical): a regrind
  // lot (see sourceRegrindJobId below) has no external supplier at all --
  // it was generated internally from a job's own scrap, not purchased. This
  // is the one column-level constraint this delivery relaxes rather than
  // purely adding to; it is backward-compatible (every pre-existing row
  // already has a real, non-null supplierId, so no existing row is
  // affected) and the correct domain model, not a workaround -- inventing a
  // fake "Internal" Supplier row instead would pollute the supplier
  // catalogue (and its PO-creation picker) with a non-vendor.
  supplierId     String?          @map("supplier_id") @db.Uuid
  supplier       Supplier?        @relation(fields: [orgId, supplierId], references: [orgId, id])
  // What the supplier itself calls this lot/batch, if they provided one --
  // free text, not validated (mirrors PurchaseOrder.supplierReference).
  supplierLotRef String?          @map("supplier_lot_ref")
  // Nullable as of this milestone -- see the model comment above.
  receiptLineId  String?          @map("receipt_line_id") @db.Uuid
  receiptLine    GoodsReceiptLine? @relation(fields: [orgId, receiptLineId], references: [orgId, id])
  warehouseId    String           @map("warehouse_id") @db.Uuid
  warehouse      Warehouse        @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantityReceived Decimal          @map("quantity_received") @db.Decimal(14, 4)
  uom              String
  status           MaterialLotStatus @default(active)
  expiryDate       DateTime?         @map("expiry_date") @db.Date
  receivedAt       DateTime          @map("received_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  // --- Return lineage (this milestone). Set together, only when this lot was
  // spawned by a "needs inspection / quarantine" return rather than a goods
  // receipt -- see returnMaterialFromJob in material-issue-service.ts. All
  // three are set once at creation and never updated (same column-grant
  // discipline as every other immutable-after-creation column on this model).
  sourceReturnOfLotId    String?       @map("source_return_of_lot_id") @db.Uuid
  sourceReturnOfLot      MaterialLot?  @relation("LotReturnLineage", fields: [orgId, sourceReturnOfLotId], references: [orgId, id])
  returnChildLots        MaterialLot[] @relation("LotReturnLineage")
  sourceReturnJobId      String?       @map("source_return_job_id") @db.Uuid
  sourceReturnJob        ProductionJob? @relation("LotReturnJob", fields: [orgId, sourceReturnJobId], references: [orgId, id])
  sourceReturnMovementId String?       @map("source_return_movement_id") @db.Uuid
  sourceReturnMovement   StockMovement? @relation("LotReturnMovement", fields: [orgId, sourceReturnMovementId], references: [orgId, id])

  // --- Regrind lineage (Milestone 6). Set together, only when this lot was
  // generated from a production job's own scrap (regrind-service.ts's
  // createRegrindLot) rather than received or returned. Deliberately a
  // JOB-level link, not a specific-source-lot link like sourceReturnOfLotId
  // above: physically regrinding scrap mixes material that may trace back
  // to several different original lots, so claiming a single-lot parent
  // would overstate the precision this process actually has. Job-level
  // traceability ("this regrind came from Job #1234's scrap") is the
  // correct, honest granularity here, not a limitation of this
  // implementation. Mutually exclusive with the return-lineage columns
  // above (enforced by a CHECK — see the migration); both are set once at
  // creation and never updated.
  sourceRegrindJobId      String?        @map("source_regrind_job_id") @db.Uuid
  sourceRegrindJob        ProductionJob? @relation("LotRegrindJob", fields: [orgId, sourceRegrindJobId], references: [orgId, id])
  sourceRegrindMovementId String?        @map("source_regrind_movement_id") @db.Uuid
  sourceRegrindMovement   StockMovement? @relation("LotRegrindMovement", fields: [orgId, sourceRegrindMovementId], references: [orgId, id])

  consumptions LotConsumption[]
  // Added by migration 20261106090000_finished_goods_inventory.
  fgAllocations FgBatchMaterialLot[]

  @@unique([orgId, lotNumber])
  @@unique([orgId, id])
  @@unique([orgId, receiptLineId])
  @@index([orgId, itemId, warehouseId])
  @@map("material_lot")
}

// Append-only usage ledger against one MaterialLot (same "one place this is
// written, never updated" discipline as StockMovement). Every row is tied 1:1
// in spirit to a slice of a StockMovement: `movementId` is the
// production_consumption or material_return movement this row is part of --
// one movement can split across several lots (one job issue drawing from
// two lots), so movementId is not unique by itself; the invariant the
// service layer enforces (and this milestone's tests verify) is that the
// LotConsumption rows sharing one movementId always sum, in absolute value,
// to that movement's own quantity.
//
// `quantity` is signed from the LOT's point of view, mirroring
// StockMovement's own sign convention: positive = drawn from the lot
// (type=consumption), negative = given back to the lot (type=return). A
// return that needs inspection does NOT create a negative row here against
// the original lot -- it spawns a new quarantined child lot instead (see
// MaterialLot.sourceReturnOfLotId) and the original consumption stands.
// remaining = quantityReceived - SUM(quantity), same formula the MaterialLot
// comment above states.
enum LotConsumptionType {
  consumption
  return
}

model LotConsumption {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  lotId       String             @map("lot_id") @db.Uuid
  lot         MaterialLot        @relation(fields: [orgId, lotId], references: [orgId, id])
  jobId       String             @map("job_id") @db.Uuid
  job         ProductionJob      @relation(fields: [orgId, jobId], references: [orgId, id])
  movementId  String             @map("movement_id") @db.Uuid
  movement    StockMovement      @relation(fields: [orgId, movementId], references: [orgId, id])
  type        LotConsumptionType
  quantity    Decimal            @db.Decimal(14, 4)
  notes       String?
  createdById String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")

  fgAllocations FgBatchMaterialLot[]

  @@unique([orgId, id])
  @@index([lotId])
  @@index([jobId])
  @@index([movementId])
  @@map("lot_consumption")
}

// ---------------------------------------------------------------------------
// FINISHED-GOODS INVENTORY — Milestone 2. Converts shop-floor "good" output
// (ProductionOutput, quantities only, Phase 3) into valued, traceable
// finished-goods stock. Deliberately NOT a new "completion" concept that
// duplicates ProductionOutput's good/scrap/rework fields: a job's output
// quantities are recorded exactly as before (output-service.ts, unchanged by
// this milestone). What's new here is the act of RECEIVING already-recorded
// good output into a finished-goods warehouse, at a chosen point in time, for
// a chosen quantity (not necessarily all of it at once — "multiple completion
// events per job" is exactly "receive finished goods is called more than
// once for the same job, each time for a slice of the good output not yet
// received"). This is the WIP -> Finished-Goods transfer the mandate asks
// for; see finished-goods-service.ts's header comment for the full design,
// including the proportional, FIFO-ordered cost and lot-genealogy allocation
// algorithm (fg-genealogy.ts) that keeps every batch's cost and lot lineage
// correct without ever double-counting material value already recognised as
// WIP cost (actual-cost.ts) or re-touching raw-material stock.
//
// A batch's quantity (goodQty) is immutable, like MaterialLot.quantityReceived.
// How much of it remains is NEVER stored -- it is computed by summing
// FgBatchMovement rows against it (transfer_out / adjustment / dispatch,
// signed), the exact same "no duplicate source of truth" convention
// MaterialLot/LotConsumption already established for raw-material lots.
//
// A WAREHOUSE TRANSFER does not mutate the batch's warehouseId (every other
// column on this model is immutable after creation, same column-grant
// discipline as MaterialLot) -- it closes out the source batch's remaining
// quantity via a `transfer_out` ledger row and spawns a brand-new
// FinishedGoodsBatch in the destination warehouse with
// `transferredFromBatchId` set, mirroring exactly how MaterialLot's
// quarantine-return spawns a new, linked child lot (sourceReturnOfLotId).
// This keeps every batch's history append-only and its lineage fully
// traceable, rather than silently rewriting where a batch "is".
enum FgBatchStatus {
  active
  quarantined
  rejected
}

enum FgBatchMovementType {
  transfer_out
  adjustment
  // Posted by Milestone 3 (Dispatch) -- the enum value is reserved now, the
  // same way MovementType already reserved sale_delivery/stock_transfer_*
  // before any milestone used them, so this schema never needs a second
  // additive migration just to add a value an already-designed feature will
  // need.
  dispatch
}

model FinishedGoodsBatch {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  branch        Branch        @relation(fields: [orgId, branchId], references: [orgId, id])
  batchNumber   String        @map("batch_number") // FG-000001..., same sequential style as LOT-/JOB-/SO-/PO-
  productItemId String        @map("product_item_id") @db.Uuid
  productItem   Item          @relation(fields: [orgId, productItemId], references: [orgId, id])
  jobId         String        @map("job_id") @db.Uuid
  job           ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  warehouseId   String        @map("warehouse_id") @db.Uuid
  warehouse     Warehouse     @relation(fields: [orgId, warehouseId], references: [orgId, id])
  // The StockMovement (movement_type = finished_goods_receipt) that brought
  // this batch's quantity into the warehouse. One batch, one receipt move --
  // a transfer spawns a NEW batch (see model comment above), it never adds a
  // second receipt movement to an existing batch.
  producedMovementId String        @map("produced_movement_id") @db.Uuid
  producedMovement    StockMovement @relation("FgBatchProducedMovement", fields: [orgId, producedMovementId], references: [orgId, id])
  goodQty       Decimal       @map("good_qty") @db.Decimal(14, 4) // immutable
  uom           String
  status        FgBatchStatus @default(active) @map("status") // the only mutable column (manual quality disposition changes)
  qualityNotes  String?       @map("quality_notes")
  producedAt    DateTime      @map("produced_at")
  createdById   String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  // --- Transfer lineage (mirrors MaterialLot.sourceReturnOfLotId exactly) ---
  transferredFromBatchId    String?             @map("transferred_from_batch_id") @db.Uuid
  transferredFromBatch      FinishedGoodsBatch? @relation("FgBatchTransferLineage", fields: [orgId, transferredFromBatchId], references: [orgId, id])
  transferChildBatches      FinishedGoodsBatch[] @relation("FgBatchTransferLineage")
  transferredFromMovementId String?             @map("transferred_from_movement_id") @db.Uuid
  // @@unique below is required, not cosmetic: fgBatchTransferredInTo on
  // StockMovement is declared singular/optional ("FinishedGoodsBatch?"),
  // which makes this a one-to-one relation to Prisma, and a one-to-one
  // relation's defining side must be backed by a unique constraint on
  // exactly these fields -- same requirement producedMovementId already
  // satisfies two fields above. It also matches the real invariant: one
  // transfer spawns exactly one child batch, so a given StockMovement is
  // never the transfer-in movement for more than one FinishedGoodsBatch.
  transferredFromMovement   StockMovement?      @relation("FgBatchTransferInMovement", fields: [orgId, transferredFromMovementId], references: [orgId, id])

  movements        FgBatchMovement[]
  materialLotLines FgBatchMaterialLot[]
  costLines        FinishedGoodsBatchCostLine[]
  dispatchAllocations DispatchBatchAllocation[]

  @@unique([orgId, batchNumber])
  @@unique([orgId, id])
  @@unique([orgId, producedMovementId])
  @@unique([orgId, transferredFromMovementId])
  @@index([orgId, productItemId, warehouseId])
  @@index([orgId, jobId])
  @@map("finished_goods_batch")
}

// Append-only usage ledger against one FinishedGoodsBatch -- the finished-
// goods mirror of LotConsumption. `quantity` is signed: negative = leaves the
// batch (transfer_out, dispatch), positive or negative = adjustment (a
// correction can go either way, unlike transfer_out/dispatch which always
// reduce). remaining = goodQty + SUM(quantity). Every row corresponds 1:1 to
// a real StockMovement (movementId, required, never null) -- this ledger
// never records a change to batch-level remaining stock that isn't also
// reflected in the existing (item, warehouse) stock_balance, so there is
// never a competing source of truth for "how much finished-goods stock
// exists" at the warehouse level.
model FgBatchMovement {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  batchId     String              @map("batch_id") @db.Uuid
  batch       FinishedGoodsBatch  @relation(fields: [orgId, batchId], references: [orgId, id])
  movementId  String              @map("movement_id") @db.Uuid
  movement    StockMovement       @relation("FgBatchMovementRef", fields: [orgId, movementId], references: [orgId, id])
  type        FgBatchMovementType
  quantity    Decimal             @db.Decimal(14, 4)
  reason      String?
  createdById String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  dispatchAllocation DispatchBatchAllocation?

  @@unique([orgId, id])
  @@index([batchId])
  @@index([movementId])
  @@map("fg_batch_movement")
}

// Finished-goods lot genealogy: how much of a specific incoming MaterialLot's
// (net) consumption by this batch's job is attributed to THIS batch, as
// opposed to any other batch the same job produced. See
// fg-genealogy.ts for the proportional (BOM-ratio), FIFO-by-consumption-order
// allocation algorithm this table records the result of -- a deliberately
// documented best-effort trace (this system does not model the physical
// mixing of a continuous process down to the unit), not a fabricated exact
// one. Append-only: a batch's genealogy is computed once, when the batch is
// created, from the job's lot-consumption ledger as it stood at that moment.
model FgBatchMaterialLot {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  batchId        String             @map("batch_id") @db.Uuid
  batch          FinishedGoodsBatch @relation(fields: [orgId, batchId], references: [orgId, id])
  lotId          String             @map("lot_id") @db.Uuid
  lot            MaterialLot        @relation(fields: [orgId, lotId], references: [orgId, id])
  lotConsumptionId String?          @map("lot_consumption_id") @db.Uuid
  lotConsumption   LotConsumption?  @relation(fields: [orgId, lotConsumptionId], references: [orgId, id])
  materialItemId String             @map("material_item_id") @db.Uuid
  materialItem   Item               @relation(fields: [orgId, materialItemId], references: [orgId, id])
  quantity       Decimal            @db.Decimal(14, 4) // positive; the amount of this lot attributed to this batch
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@index([batchId])
  @@index([lotId])
  @@map("fg_batch_material_lot")
}

// This batch's allocated share of the job's WIP cost, one row per currency --
// same "never silently mix currencies" convention as JobCostEstimateLine /
// JobCostActualLine. See finished-goods-service.ts's computeBatchCostLines
// for the allocation algorithm (proportional to this batch's share of the
// job's cumulative good output, clamped so the sum across every batch of a
// job can never exceed that job's own actual cost in that currency --
// "never count material value twice").
model FinishedGoodsBatchCostLine {
  orgId        String             @map("org_id") @db.Uuid
  batchId      String             @map("batch_id") @db.Uuid
  batch        FinishedGoodsBatch @relation(fields: [orgId, batchId], references: [orgId, id])
  currency     String             @db.Char(3)
  materialCost Decimal            @map("material_cost") @db.Decimal(14, 4)
  // null = no labour recorded in this currency for the job at receipt time (not "zero") -- same convention as JobCostActualLine.
  labourCost   Decimal?           @map("labour_cost") @db.Decimal(14, 4)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@id([batchId, currency])
  @@map("finished_goods_batch_cost_line")
}

enum SalesOrderStatus {
  draft
  confirmed
  in_production
  partially_delivered
  delivered
  closed
  cancelled
}

model SalesOrder {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String           @map("org_id") @db.Uuid
  branchId              String           @map("branch_id") @db.Uuid
  branch                Branch           @relation(fields: [orgId, branchId], references: [orgId, id])
  orderNumber           String           @map("order_number")
  customerId            String           @map("customer_id") @db.Uuid
  customer              Customer         @relation(fields: [orgId, customerId], references: [orgId, id])
  status                SalesOrderStatus @default(draft)
  currency              String           @db.Char(3)
  requestedDeliveryDate DateTime?        @map("requested_delivery_date") @db.Date
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  lines      SalesOrderLine[]
  dispatches Dispatch[]

  @@unique([orgId, orderNumber])
  @@unique([orgId, id])
  @@map("sales_order")
}

model SalesOrderLine {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [orgId, salesOrderId], references: [orgId, id], onDelete: Cascade)
  itemId       String     @map("item_id") @db.Uuid
  item         Item       @relation(fields: [orgId, itemId], references: [orgId, id])
  quantity     Decimal    @db.Decimal(14, 4)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(14, 4)
  currency     String     @db.Char(3)

  productionJob ProductionJob?
  dispatchLines DispatchLine[]

  @@unique([orgId, id])
  @@map("sales_order_line")
}

// ---------------------------------------------------------------------------
// DISPATCH AND DELIVERY (Milestone 3) -- fulfilling a confirmed sales order
// from finished-goods stock.
//
// Two distinct events, deliberately kept separate (see
// dispatch-service.ts's header comment for the full rationale):
//  - DISPATCH (createDispatch): goods physically leave a warehouse. This is
//    the inventory-integrity event -- it posts a real StockMovement
//    (movement_type = sale_delivery, negative) per finished-goods batch
//    drawn from, debits that batch's own ledger (FgBatchMovement,
//    type = dispatch), and recomputes the SalesOrder's status from
//    cumulative dispatched quantity vs. ordered quantity. Only `active`
//    finished-goods batches are eligible -- shipping quarantined or
//    rejected stock to a customer is refused outright, not just discouraged.
//  - DELIVERY CONFIRMATION (confirmDelivery): a Dispatch's proof-of-delivery
//    record (who received it, when, any notes). Purely informational --
//    it moves no stock and does not change the SalesOrder's status (which
//    is already driven by what shipped, not by what was confirmed
//    received). This is a deliberate reading of SalesOrderStatus's existing
//    "delivered" value as "fully shipped," not "customer has signed for
//    it" -- the schema's enum was fixed before this milestone and is not
//    changed here; see IMPLEMENTATION_MANIFEST.md Milestone 3 for the full
//    reasoning and the known limitation this implies (no separate
//    "awaiting delivery confirmation" order-level state).
//
// DispatchLine.quantity is the line's total; DispatchBatchAllocation is the
// forward-chain ledger of exactly which batch(es) that quantity was picked
// from, append-only (prevent_mutation() trigger), one row per real
// FgBatchMovement -- the dispatch-side mirror of FgBatchMaterialLot's
// genealogy-ledger discipline on the receiving side. There is no reversal
// or "sales return" flow in this milestone (see dispatch-service.ts's
// header for why) -- a Dispatch, once created, is a permanent record; only
// its status/deliveredAt/receivedBy/deliveryNotes columns are ever mutated,
// by confirmDelivery, via the same column-scoped GRANT discipline
// finished_goods_batch already uses for its own status/quality_notes.
// ---------------------------------------------------------------------------

enum DispatchStatus {
  dispatched // goods have left the warehouse; awaiting delivery confirmation
  delivered // proof-of-delivery recorded
}

model Dispatch {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  branch            Branch         @relation(fields: [orgId, branchId], references: [orgId, id])
  dispatchNumber    String         @map("dispatch_number") // DN-000001..., same sequential style as FG-/LOT-/JOB-/SO-/PO-
  salesOrderId      String         @map("sales_order_id") @db.Uuid
  salesOrder        SalesOrder     @relation(fields: [orgId, salesOrderId], references: [orgId, id])
  warehouseId       String         @map("warehouse_id") @db.Uuid
  warehouse         Warehouse      @relation(fields: [orgId, warehouseId], references: [orgId, id])
  status            DispatchStatus @default(dispatched)
  dispatchedAt      DateTime       @map("dispatched_at")
  carrier           String?
  trackingReference String?        @map("tracking_reference")
  notes             String?
  // --- Delivery confirmation (confirmDelivery) -- the only mutable columns ---
  deliveredAt   DateTime? @map("delivered_at")
  receivedBy    String?   @map("received_by")
  deliveryNotes String?   @map("delivery_notes")
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  lines DispatchLine[]

  @@unique([orgId, dispatchNumber])
  @@unique([orgId, id])
  @@index([orgId, salesOrderId])
  @@index([orgId, warehouseId])
  @@map("dispatch")
}

model DispatchLine {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  dispatchId       String         @map("dispatch_id") @db.Uuid
  dispatch         Dispatch       @relation(fields: [orgId, dispatchId], references: [orgId, id], onDelete: Cascade)
  salesOrderLineId String         @map("sales_order_line_id") @db.Uuid
  salesOrderLine   SalesOrderLine @relation(fields: [orgId, salesOrderLineId], references: [orgId, id])
  quantity         Decimal        @db.Decimal(14, 4) // immutable; positive; sum of this line's batchAllocations
  uom              String

  batchAllocations DispatchBatchAllocation[]

  @@unique([orgId, id])
  @@index([salesOrderLineId])
  @@index([dispatchId])
  @@map("dispatch_line")
}

// Append-only forward-traceability ledger: which finished-goods batch(es) a
// dispatch line's quantity was picked from, and how much from each. One row
// per real FgBatchMovement (type = dispatch) -- see the section comment
// above. `quantity` is denormalized from fgBatchMovement.quantity (negated)
// for query convenience only; fgBatchMovement remains the authoritative
// ledger entry.
model DispatchBatchAllocation {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  dispatchLineId   String             @map("dispatch_line_id") @db.Uuid
  dispatchLine     DispatchLine       @relation(fields: [orgId, dispatchLineId], references: [orgId, id], onDelete: Cascade)
  batchId          String             @map("batch_id") @db.Uuid
  batch            FinishedGoodsBatch @relation(fields: [orgId, batchId], references: [orgId, id])
  fgBatchMovementId String            @map("fg_batch_movement_id") @db.Uuid
  fgBatchMovement   FgBatchMovement   @relation(fields: [orgId, fgBatchMovementId], references: [orgId, id])
  quantity         Decimal            @db.Decimal(14, 4) // positive
  createdAt        DateTime           @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@unique([orgId, fgBatchMovementId])
  @@index([dispatchLineId])
  @@index([batchId])
  @@map("dispatch_batch_allocation")
}

// ---------------------------------------------------------------------------
// PRODUCTION
// ---------------------------------------------------------------------------

enum ProductionJobStatus {
  planned
  released
  in_progress
  on_hold
  completed
  closed
  cancelled
}

model ProductionJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  branch           Branch              @relation(fields: [orgId, branchId], references: [orgId, id])
  jobNumber        String              @map("job_number")
  salesOrderLineId String?             @map("sales_order_line_id") @db.Uuid
  salesOrderLine   SalesOrderLine?     @relation(fields: [orgId, salesOrderLineId], references: [orgId, id])
  customerId       String?             @map("customer_id") @db.Uuid
  customer         Customer?           @relation(fields: [orgId, customerId], references: [orgId, id])
  productItemId    String              @map("product_item_id") @db.Uuid
  productItem      Item                @relation(fields: [orgId, productItemId], references: [orgId, id])
  bomId            String              @map("bom_id") @db.Uuid
  bom              BillOfMaterial      @relation(fields: [orgId, bomId], references: [orgId, id])
  plannedQty       Decimal             @map("planned_qty") @db.Decimal(14, 4)
  plannedStart     DateTime?           @map("planned_start") @db.Date
  plannedEnd       DateTime?           @map("planned_end") @db.Date
  actualStart      DateTime?           @map("actual_start")
  actualEnd        DateTime?           @map("actual_end")
  status           ProductionJobStatus @default(planned)
  quotedAmount     Decimal?            @map("quoted_amount") @db.Decimal(14, 4)
  quotedCurrency   String?             @map("quoted_currency") @db.Char(3)
  createdById      String?             @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  materialRequirements MaterialRequirement[]
  labourRecords        LabourRecord[]
  costEstimate         JobCostEstimate?
  costEstimateLines    JobCostEstimateLine[]
  costActualLines      JobCostActualLine[]
  costActual           JobCostActual?
  costAdjustments      JobCostAdjustment[]
  stages               ProductionJobStage[]
  qualityRecords       QualityRecord[]
  outputs              ProductionOutput[]
  outputVoids          ProductionOutputVoid[]
  dispositions         QualityDisposition[]
  // Added by migration 20261105120000_lot_consumption_and_traceability.
  lotConsumptions      LotConsumption[]
  // Reverse of MaterialLot.sourceReturnJobId: quarantine lots spawned by a
  // return FROM this job (not the lots this job consumed -- see
  // lotConsumptions above and getJobLotConsumption in lot-service.ts for that).
  returnSpawnedLots    MaterialLot[]          @relation("LotReturnJob")
  // Added by migration 20261106090000_finished_goods_inventory.
  finishedGoodsBatches FinishedGoodsBatch[]
  // Milestone 4 additions
  machineTimeRecords   MachineTimeRecord[]
  correctiveActions    CorrectiveAction[]
  priority             JobPriority            @default(normal)
  // Milestone 6: reverse of MaterialLot.sourceRegrindJobId -- regrind lots
  // generated from THIS job's scrap (distinct from returnSpawnedLots above,
  // which is the unrelated M1 "returned unused material" lineage).
  regrindSpawnedLots   MaterialLot[]          @relation("LotRegrindJob")

  @@unique([orgId, jobNumber])
  @@unique([orgId, id])
  @@unique([orgId, salesOrderLineId]) // backs the 1:1 FK above
  @@index([branchId, status])
  @@map("production_job")
}

model MaterialRequirement {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  jobId          String        @map("job_id") @db.Uuid
  job            ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id], onDelete: Cascade)
  materialItemId String        @map("material_item_id") @db.Uuid
  materialItem   Item          @relation(fields: [orgId, materialItemId], references: [orgId, id])
  expectedQty    Decimal       @map("expected_qty") @db.Decimal(14, 4)
  uom            String
  // Snapshot of the item's standard cost when the job was created. Null =
  // the item had no standard cost ("unpriced") -- never a guessed number.
  standardUnitCost         Decimal? @map("standard_unit_cost") @db.Decimal(14, 4)
  standardUnitCostCurrency String?  @map("standard_unit_cost_currency") @db.Char(3)

  @@index([jobId])
  @@map("material_requirement")
}

model LabourRecord {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  // Milestone 4: optional operation-level attribution. Null keeps today's
  // meaning exactly -- "job-level labour, no specific operation" -- so every
  // existing LabourRecord row (and every caller that doesn't pass it) is
  // unaffected. See labour-service.ts.
  jobStageId      String?             @map("job_stage_id") @db.Uuid
  jobStage        ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  userId          String?       @map("user_id") @db.Uuid
  hours           Decimal       @db.Decimal(8, 2)
  rate            Decimal       @db.Decimal(14, 4)
  rateCurrency    String        @map("rate_currency") @db.Char(3)
  clientRequestId String?       @map("client_request_id") @db.Uuid
  recordedAt      DateTime      @default(now()) @map("recorded_at")

  @@unique([orgId, clientRequestId]) // composite, not global
  @@index([jobId])
  @@index([jobStageId])
  @@map("labour_record")
}

model ProductionStageTemplate {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  productItemId String? @map("product_item_id") @db.Uuid
  product       Item?   @relation(fields: [orgId, productItemId], references: [orgId, id])
  stageName     String  @map("stage_name")
  sequence      Int
  // Milestone 4: expected routing figures a job's stage copies at
  // definition time (same snapshot discipline as the job's BOM lines --
  // see job-service.ts's header comment). Null = not estimated, unchanged
  // from today.
  workCentreId       String?  @map("work_centre_id") @db.Uuid
  workCentre         WorkCentre? @relation(fields: [orgId, workCentreId], references: [orgId, id])
  expectedSetupMinutes Int?   @map("expected_setup_minutes")
  expectedRunMinutes   Int?   @map("expected_run_minutes")

  @@unique([orgId, id])
  @@map("production_stage_template")
}

enum ProductionJobStageStatus {
  pending
  in_progress
  completed
}

model ProductionJobStage {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String                   @map("org_id") @db.Uuid
  jobId           String                   @map("job_id") @db.Uuid
  job             ProductionJob            @relation(fields: [orgId, jobId], references: [orgId, id], onDelete: Cascade)
  stageName       String                   @map("stage_name")
  sequence        Int
  status          ProductionJobStageStatus @default(pending)
  startedAt       DateTime?                @map("started_at")
  completedAt     DateTime?                @map("completed_at")
  operatorUserId  String?                  @map("operator_user_id") @db.Uuid
  qtyProcessed    Decimal?                 @map("qty_processed") @db.Decimal(14, 4)
  qtyRejected     Decimal?                 @map("qty_rejected") @db.Decimal(14, 4)
  notes           String?
  clientRequestId String?                  @map("client_request_id") @db.Uuid
  // Phase 3
  plannedStart       DateTime? @map("planned_start")
  plannedEnd         DateTime? @map("planned_end")
  // Free-text, kept for backward compatibility with stages defined before
  // Milestone 4 (and as a fallback when no Machine/WorkCentre register entry
  // fits). New stages should prefer workCentreId/machineId below, which are
  // real, reportable FKs the capacity-visibility report (capacity-service.ts)
  // and machine utilisation views can actually group by; this string can't be.
  workCentre         String?   @map("work_centre")
  // Milestone 4: real work-centre/machine register references, snapshotted
  // onto the stage at definition time (stage-service.ts's defineStages),
  // exactly like workCentre/expectedSetupMinutes/expectedRunMinutes below --
  // later edits to the WorkCentre/Machine row (e.g. renaming it, changing its
  // capacity) never rewrite what an existing stage was planned against.
  workCentreId         String?     @map("work_centre_id") @db.Uuid
  workCentreRef        WorkCentre? @relation("StageWorkCentre", fields: [orgId, workCentreId], references: [orgId, id])
  machineId            String?     @map("machine_id") @db.Uuid
  machine              Machine?    @relation(fields: [orgId, machineId], references: [orgId, id])
  expectedSetupMinutes Int?        @map("expected_setup_minutes")
  expectedRunMinutes   Int?        @map("expected_run_minutes")
  requiresInspection Boolean   @default(false) @map("requires_inspection")
  blockedReason      String?   @map("blocked_reason")
  blockedAt          DateTime? @map("blocked_at")
  blockedById        String?   @map("blocked_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  qualityRecords QualityRecord[]
  outputs        ProductionOutput[]
  machineTimeRecords MachineTimeRecord[]
  labourRecords  LabourRecord[]
  // Milestone 6
  plasticsProcessDetail PlasticsProcessDetail?

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@unique([jobId, sequence])
  @@map("production_job_stage")
}

enum RejectReason {
  wrong_dimensions
  damaged
  paint_defect
  missing_component
  other
}

model QualityRecord {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String              @map("org_id") @db.Uuid
  jobId           String              @map("job_id") @db.Uuid
  job             ProductionJob       @relation(fields: [orgId, jobId], references: [orgId, id])
  jobStageId      String?             @map("job_stage_id") @db.Uuid
  jobStage        ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  producedQty     Decimal             @map("produced_qty") @db.Decimal(14, 4)
  acceptedQty     Decimal             @map("accepted_qty") @db.Decimal(14, 4)
  rejectedQty     Decimal             @map("rejected_qty") @db.Decimal(14, 4)
  rejectReason    RejectReason?       @map("reject_reason")
  notes           String?
  evidenceRef     String?             @map("evidence_ref")
  clientRequestId String?             @map("client_request_id") @db.Uuid
  recordedAt      DateTime            @default(now()) @map("recorded_at")
  // Phase 3: an inspection RESULT. produced_qty = units inspected;
  // accepted + rejected = produced; outcome = 'pass' iff nothing rejected.
  inspectorUserId String?             @map("inspector_user_id") @db.Uuid
  outcome         String?
  uom             String?

  dispositions QualityDisposition[]
  outputs      ProductionOutput[]
  // Milestone 4
  measurements      QualityMeasurement[]
  correctiveActions CorrectiveAction[]
  inspectionPlanId  String?        @map("inspection_plan_id") @db.Uuid
  inspectionPlan    InspectionPlan? @relation(fields: [orgId, inspectionPlanId], references: [orgId, id])

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@map("quality_record")
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model Warehouse {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  branch   Branch  @relation(fields: [orgId, branchId], references: [orgId, id])
  name     String
  isActive Boolean @default(true) @map("is_active")

  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  goodsReceiptLines GoodsReceiptLine[]
  materialLots      MaterialLot[]
  finishedGoodsBatches FinishedGoodsBatch[]
  dispatches           Dispatch[]

  @@unique([branchId, name])
  @@unique([orgId, id])
  @@map("warehouse")
}

enum MovementType {
  purchase_receipt
  material_issue
  material_return
  production_consumption
  finished_goods_receipt
  sale_delivery
  adjustment
  stock_transfer_out
  stock_transfer_in
  // Milestone 6 (Plastics Manufacturing Vertical): a regrind lot entering
  // inventory (regrind-service.ts's createRegrindLot). Deliberately its own
  // value, never purchase_receipt -- any report that sums purchase_receipt
  // to answer "how much material did we buy" must never need to know
  // regrind exists to be correct; it already excludes it by construction.
  regrind_generation
}

enum ReferenceType {
  production_job
  purchase_order
  sales_order
  manual
}

model StockMovement {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid // denormalized from warehouse.branchId, validated by trigger
  itemId          String         @map("item_id") @db.Uuid
  item            Item           @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId     String         @map("warehouse_id") @db.Uuid
  warehouse       Warehouse      @relation(fields: [orgId, warehouseId], references: [orgId, id])
  movementType    MovementType   @map("movement_type")
  quantity        Decimal        @db.Decimal(14, 4) // signed
  unitCost        Decimal?       @map("unit_cost") @db.Decimal(14, 4) // required on receipts; system-stamped on consumption
  currency        String?        @db.Char(3)
  referenceType   ReferenceType? @map("reference_type")
  referenceId     String?        @map("reference_id") @db.Uuid
  reason          String?
  clientRequestId String?        @map("client_request_id") @db.Uuid
  createdById     String?        @map("created_by") @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  syncedAt        DateTime       @default(now()) @map("synced_at")

  // Added by migration 20261105120000_lot_consumption_and_traceability so
  // MaterialLot/LotConsumption rows can carry a composite (orgId, movementId)
  // FK back to the exact movement they were created from or returned against
  // -- same org-isolation-at-the-constraint-level convention every other
  // relation in this schema already uses, not previously needed because
  // nothing referenced a StockMovement row before this milestone.
  lotConsumptions LotConsumption[]
  lotsReturnedFrom MaterialLot[]  @relation("LotReturnMovement")
  // Milestone 6: the regrind_generation movement a regrind lot was posted
  // with (see MaterialLot.sourceRegrindMovementId).
  lotsFromRegrind MaterialLot[]  @relation("LotRegrindMovement")
  // Added by migration 20261106090000_finished_goods_inventory.
  fgBatchProduced        FinishedGoodsBatch? @relation("FgBatchProducedMovement")
  fgBatchTransferredInTo FinishedGoodsBatch? @relation("FgBatchTransferInMovement")
  fgBatchMovements       FgBatchMovement[]   @relation("FgBatchMovementRef")

  @@unique([orgId, clientRequestId])
  @@unique([orgId, id])
  @@index([itemId, warehouseId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movement")
}

// Written ONLY by the trg_stock_movement_before_insert trigger (SECURITY
// DEFINER). Never call prisma.stockBalance.create/update/upsert; reads only.
model StockBalance {
  orgId                   String    @map("org_id") @db.Uuid
  itemId                  String    @map("item_id") @db.Uuid
  item                    Item      @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId             String    @map("warehouse_id") @db.Uuid
  warehouse               Warehouse @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantity                Decimal   @default(0) @db.Decimal(14, 4)
  averageUnitCost         Decimal?  @map("average_unit_cost") @db.Decimal(14, 4)
  averageUnitCostCurrency String?   @map("average_unit_cost_currency") @db.Char(3)
  updatedAt               DateTime  @default(now()) @map("updated_at")

  @@id([itemId, warehouseId])
  @@map("stock_balance")
}

// ---------------------------------------------------------------------------
// COSTING
// ---------------------------------------------------------------------------

// Header only. Amounts live in JobCostEstimateLine, one row per currency, so an
// estimate can never silently mix currencies. unpricedMaterials lists the
// materials that could not be priced and why:
//   [{ materialItemId, reason: "no_standard_cost" | "uom_mismatch" }]
model JobCostEstimate {
  orgId             String        @map("org_id") @db.Uuid
  jobId             String        @id @map("job_id") @db.Uuid
  job               ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  unpricedMaterials Json          @default("[]") @map("unpriced_materials")
  computedAt        DateTime      @default(now()) @map("computed_at")

  @@unique([orgId, jobId])
  @@map("job_cost_estimate")
}

model JobCostEstimateLine {
  orgId                 String        @map("org_id") @db.Uuid
  jobId                 String        @map("job_id") @db.Uuid
  job                   ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency              String        @db.Char(3)
  estimatedMaterialCost Decimal       @map("estimated_material_cost") @db.Decimal(14, 4)
  estimatedLabourCost   Decimal?      @map("estimated_labour_cost") @db.Decimal(14, 4)
  estimatedOverheadCost Decimal?      @map("estimated_overhead_cost") @db.Decimal(14, 4)

  @@id([jobId, currency])
  @@map("job_cost_estimate_line")
}

// One row per organization; incremented inside the job-creation transaction.
model JobNumberCounter {
  orgId      String       @id @map("org_id") @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  lastNumber Int          @default(0) @map("last_number")

  @@map("job_number_counter")
}

// Completion snapshot, written ONCE when a job completes and never changed
// (DB immutability trigger). Header = revenue basis (the job's quote at
// completion); amounts live in JobCostActualLine, one row per currency, so an
// actual cost can never silently mix currencies. Gross profit is derived on
// read (only when all cost is in the revenue currency), never stored.
model JobCostActual {
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @id @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  revenue         Decimal?      @db.Decimal(14, 4)
  revenueCurrency String?       @map("revenue_currency") @db.Char(3)
  snapshottedAt   DateTime      @default(now()) @map("snapshotted_at")
  // What was and was not known at completion (missing components, unpriced
  // materials...) and which records were counted. Frozen with the snapshot.
  // {"legacy": true} marks snapshots written before these columns existed.
  completeness    Json          @default("{\"legacy\": true}")
  evidence        Json          @default("{}")

  @@unique([orgId, jobId])
  @@map("job_cost_actual")
}

model JobCostActualLine {
  orgId              String        @map("org_id") @db.Uuid
  jobId              String        @map("job_id") @db.Uuid
  job                ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency           String        @db.Char(3)
  actualMaterialCost Decimal       @map("actual_material_cost") @db.Decimal(14, 4)
  // null = no labour was recorded in this currency (not "zero").
  actualLabourCost   Decimal?      @map("actual_labour_cost") @db.Decimal(14, 4)
  // null = unavailable until an overhead allocation method is approved.
  actualOverheadCost Decimal?      @map("actual_overhead_cost") @db.Decimal(14, 4)

  @@id([jobId, currency])
  @@map("job_cost_actual_line")
}

// Explicit, append-only correction to a FROZEN job cost. The snapshot is never
// edited; effective actual cost = snapshot + adjustments. Only against a job
// that has a snapshot (DB trigger), always with a reason (>= 10 chars).
model JobCostAdjustment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency        String        @db.Char(3)
  component       String // "material" | "labour" (CHECK in the database)
  amount          Decimal       @db.Decimal(14, 4)
  reason          String
  clientRequestId String?       @map("client_request_id") @db.Uuid
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([orgId, clientRequestId])
  @@index([jobId])
  @@map("job_cost_adjustment")
}

// ---------------------------------------------------------------------------
// SHOP FLOOR (Phase 3). All append-only; see migration 20261022100000.
// ---------------------------------------------------------------------------

// Good / scrap / rework quantities recorded against a job (and stage).
model ProductionOutput {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                   String              @map("org_id") @db.Uuid
  jobId                   String              @map("job_id") @db.Uuid
  job                     ProductionJob       @relation(fields: [orgId, jobId], references: [orgId, id])
  jobStageId              String?             @map("job_stage_id") @db.Uuid
  jobStage                ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  goodQty                 Decimal             @default(0) @map("good_qty") @db.Decimal(14, 4)
  scrapQty                Decimal             @default(0) @map("scrap_qty") @db.Decimal(14, 4)
  reworkQty               Decimal             @default(0) @map("rework_qty") @db.Decimal(14, 4)
  reworkGoodQty           Decimal             @default(0) @map("rework_good_qty") @db.Decimal(14, 4)
  reworkScrapQty          Decimal             @default(0) @map("rework_scrap_qty") @db.Decimal(14, 4)
  reclassifiedFromGoodQty Decimal             @default(0) @map("reclassified_from_good_qty") @db.Decimal(14, 4)
  uom                     String
  reason                  RejectReason?
  notes                   String?
  source                  String              @default("operator")
  inspectionId            String?             @map("inspection_id") @db.Uuid
  inspection              QualityRecord?      @relation(fields: [orgId, inspectionId], references: [orgId, id])
  operatorUserId          String?             @map("operator_user_id") @db.Uuid
  recordedAt              DateTime            @default(now()) @map("recorded_at")
  clientRequestId         String?             @map("client_request_id") @db.Uuid

  void ProductionOutputVoid?

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@index([jobId])
  @@map("production_output")
}

// A reasoned reversal of one output entry. The entry itself is never edited.
model ProductionOutputVoid {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String           @map("org_id") @db.Uuid
  jobId    String           @map("job_id") @db.Uuid
  job      ProductionJob    @relation(fields: [orgId, jobId], references: [orgId, id])
  outputId String           @map("output_id") @db.Uuid
  output   ProductionOutput @relation(fields: [orgId, outputId], references: [orgId, id])
  reason   String
  voidedBy String?          @map("voided_by") @db.Uuid
  voidedAt DateTime         @default(now()) @map("voided_at")

  @@unique([orgId, outputId])
  @@map("production_output_void")
}

// An authorised decision on rejected units of one inspection.
model QualityDisposition {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  inspectionId    String        @map("inspection_id") @db.Uuid
  inspection      QualityRecord @relation(fields: [orgId, inspectionId], references: [orgId, id])
  kind            String // scrap | rework | use_as_is (CHECK in the database)
  qty             Decimal       @db.Decimal(14, 4)
  reason          String
  decidedBy       String        @map("decided_by") @db.Uuid
  decidedAt       DateTime      @default(now()) @map("decided_at")
  clientRequestId String?       @map("client_request_id") @db.Uuid

  @@unique([orgId, clientRequestId])
  @@index([inspectionId])
  @@map("quality_disposition")
}

// ============================================================================
// MILESTONE 4 — Full Manufacturing Lifecycle
// ============================================================================
// Four additions, each extending an existing Phase-3 shop-floor pattern
// rather than inventing a parallel one:
//   1. Machines & work centres        -- a real register; stages/templates
//      above now carry workCentreId/machineId snapshots alongside the old
//      free-text workCentre column (kept for backward compatibility).
//   2. Machine time                   -- an append-only ledger, same shape
//      and idempotency discipline as LabourRecord.
//   3. Quality plans & measurements   -- an optional, reusable "what to
//      check and its tolerances" layer that recordInspection (quality-
//      service.ts) can attach measurements to; the existing pass/fail
//      (QualityRecord.outcome, driven by rejectedQty) is UNCHANGED and
//      remains the one gate stage completion/job completion check --
//      per-characteristic pass/fail recorded here is diagnostic detail, not
//      a second, competing gate.
//   4. Corrective actions             -- a lightweight tracker linkable to
//      a failed inspection (quality_record), separate from disposition
//      (which only ever decides what happens to the REJECTED UNITS, never
//      to the root cause).
// None of this touches StockMovement/StockBalance or the costing tables'
// write paths -- JobCostEstimateLine/JobCostActualLine.estimatedOverheadCost/
// actualOverheadCost remain untouched (still null = "unavailable until an
// overhead allocation method is approved": see job-service.ts/completion-
// snapshot.ts). Machine time is captured here for genuine shop-floor
// visibility and reporting; it is deliberately NOT auto-rolled into
// actualOverheadCost, which would silently invent an allocation methodology
// nobody has approved (§11/§6 of the mandate).

enum JobPriority {
  low
  normal
  high
  urgent
}

enum MachineStatus {
  available
  in_use
  down
  maintenance
  retired
}

enum DowntimeCategory {
  breakdown
  changeover
  no_material
  no_operator
  planned_maintenance
  other
}

enum MaintenanceType {
  scheduled
  unscheduled
}

enum CorrectiveActionStatus {
  open
  in_progress
  completed
  cancelled
}

// A department/area on the shop floor (e.g. "Extrusion", "Assembly Line 2").
// Branch-scoped, same level as Warehouse -- stock lives in a branch's
// warehouses, work happens in a branch's work centres.
model WorkCentre {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  branch   Branch  @relation(fields: [orgId, branchId], references: [orgId, id])
  code     String
  name     String
  // Optional configured capacity for the capacity-visibility report
  // (capacity-service.ts). Null = "not configured" -- the report then shows
  // assigned load only, with no utilisation percentage, rather than
  // guessing a capacity. This is deliberately a simple daily-minutes figure,
  // not a shift calendar or finite-capacity model (mandate §6: "avoid
  // claiming finite-capacity scheduling if the implementation only performs
  // simple date allocation").
  dailyCapacityMinutes Int?    @map("daily_capacity_minutes")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  machines         Machine[]
  stageTemplates   ProductionStageTemplate[]
  jobStages        ProductionJobStage[] @relation("StageWorkCentre")

  @@unique([orgId, id])
  @@unique([branchId, code])
  @@map("work_centre")
}

// A specific piece of equipment within a work centre.
model Machine {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  workCentreId String        @map("work_centre_id") @db.Uuid
  workCentre   WorkCentre    @relation(fields: [orgId, workCentreId], references: [orgId, id])
  code         String
  name         String
  status       MachineStatus @default(available)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  jobStages           ProductionJobStage[]
  machineTimeRecords  MachineTimeRecord[]
  downtimeRecords     MachineDowntimeRecord[]
  maintenanceRecords  MachineMaintenanceRecord[]
  // Milestone 6
  mouldCompatibilities MouldMachineCompatibility[]

  @@unique([orgId, id])
  @@unique([workCentreId, code])
  @@map("machine")
}

// Append-only downtime log. A machine's current `status` is the operator's
// own explicit signal (set via machine-service.ts); this table is the
// historical record of WHY and for how long -- closing a record (setting
// endedAt) never edits or removes the open record, it is the same row
// transitioning from open (endedAt null) to closed, same convention stage
// blocking already uses (blockedReason/blockedAt vs this table's started/
// ended) -- never a second, competing "is it down" source of truth: a
// machine can only be set to `down` while a downtime record is opened for
// it, and leaving `down` requires closing that record first (machine-
// service.ts).
model MachineDowntimeRecord {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String            @map("org_id") @db.Uuid
  machineId  String            @map("machine_id") @db.Uuid
  machine    Machine           @relation(fields: [orgId, machineId], references: [orgId, id])
  category   DowntimeCategory
  reason     String
  startedAt  DateTime          @default(now()) @map("started_at")
  endedAt    DateTime?         @map("ended_at")
  loggedById String?           @map("logged_by") @db.Uuid

  @@unique([orgId, id])
  @@index([machineId, endedAt])
  @@map("machine_downtime_record")
}

// Maintenance schedule AND history in one append-only table: a row with
// completedAt null and a future scheduledAt is a planned/scheduled entry; a
// row with completedAt set is history. Never edited once completed -- a
// mistaken completion is corrected by a new row, same "never edit immutable
// historical records" rule as everywhere else in this codebase (see output-
// service.ts's header comment for the canonical statement of it).
model MachineMaintenanceRecord {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  machineId     String          @map("machine_id") @db.Uuid
  machine       Machine         @relation(fields: [orgId, machineId], references: [orgId, id])
  type          MaintenanceType
  scheduledAt   DateTime?       @map("scheduled_at")
  completedAt   DateTime?       @map("completed_at")
  notes         String?
  performedById String?         @map("performed_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@index([machineId])
  @@map("machine_maintenance_record")
}

// Actual setup/run time against a job (optionally a specific stage and
// machine). Idempotent by (orgId, clientRequestId), same discipline as
// LabourRecord/ProductionOutput -- an offline client can retry safely.
model MachineTimeRecord {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String              @map("org_id") @db.Uuid
  jobId           String              @map("job_id") @db.Uuid
  job             ProductionJob       @relation(fields: [orgId, jobId], references: [orgId, id])
  jobStageId      String?             @map("job_stage_id") @db.Uuid
  jobStage        ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  machineId       String              @map("machine_id") @db.Uuid
  machine         Machine             @relation(fields: [orgId, machineId], references: [orgId, id])
  setupMinutes    Int                 @default(0) @map("setup_minutes")
  runMinutes      Int                 @default(0) @map("run_minutes")
  operatorUserId  String?             @map("operator_user_id") @db.Uuid
  clientRequestId String?             @map("client_request_id") @db.Uuid
  recordedAt      DateTime            @default(now()) @map("recorded_at")

  @@unique([orgId, clientRequestId])
  @@index([jobId])
  @@index([machineId])
  @@map("machine_time_record")
}

// "What to check and its tolerances" for an item (material OR finished
// product -- itemId, not productItemId, so the same model serves incoming
// inspection of a purchased material and in-process/final inspection of a
// manufactured product). Deliberately NOT versioned like BillOfMaterial: a
// plan is a checklist template, not a value that must be preserved
// unchanged for costing/history reasons -- every recorded measurement
// already freezes its own characteristic's name/tolerances by copying them
// (see QualityMeasurement below), so an edited plan can't retroactively
// change what a past measurement meant. A characteristic already used by a
// measurement is retired (isActive=false), never deleted, so old
// measurements keep a live FK.
model InspectionPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  item      Item     @relation(fields: [orgId, itemId], references: [orgId, id])
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdById String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  characteristics InspectionCharacteristic[]
  qualityRecords  QualityRecord[]

  @@unique([orgId, id])
  @@index([itemId])
  @@map("inspection_plan")
}

model InspectionCharacteristic {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  planId     String         @map("plan_id") @db.Uuid
  plan       InspectionPlan @relation(fields: [orgId, planId], references: [orgId, id], onDelete: Cascade)
  name       String
  uom        String?
  minValue   Decimal?       @map("min_value") @db.Decimal(14, 4)
  maxValue   Decimal?       @map("max_value") @db.Decimal(14, 4)
  targetValue Decimal?      @map("target_value") @db.Decimal(14, 4)
  sequence   Int
  isActive   Boolean        @default(true) @map("is_active")

  measurements QualityMeasurement[]

  @@unique([orgId, id])
  @@index([planId])
  @@map("inspection_characteristic")
}

// One measured value against one characteristic, recorded alongside an
// inspection (quality_record). `passed` is computed and stored at write time
// from the characteristic's min/max AS THEY STOOD then (characteristicName/
// Uom/MinValue/MaxValue below are a snapshot copy, same reasoning as
// MaterialRequirement snapshotting its BOM line) -- editing or retiring the
// characteristic later never changes what a past measurement's pass/fail meant.
// This is diagnostic detail: it does NOT feed QualityRecord.outcome or
// rejectedQty, which stay driven entirely by what the inspector explicitly
// recorded as rejected (quality-service.ts recordInspection) -- one gate,
// not two that could disagree.
model QualityMeasurement {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  qualityRecordId    String          @map("quality_record_id") @db.Uuid
  qualityRecord      QualityRecord   @relation(fields: [orgId, qualityRecordId], references: [orgId, id], onDelete: Cascade)
  characteristicId   String          @map("characteristic_id") @db.Uuid
  characteristic     InspectionCharacteristic @relation(fields: [orgId, characteristicId], references: [orgId, id])
  characteristicName String          @map("characteristic_name")
  uom                String?
  minValue           Decimal?        @map("min_value") @db.Decimal(14, 4)
  maxValue           Decimal?        @map("max_value") @db.Decimal(14, 4)
  measuredValue      Decimal         @map("measured_value") @db.Decimal(14, 4)
  passed             Boolean
  recordedAt         DateTime        @default(now()) @map("recorded_at")

  @@unique([orgId, id])
  @@index([qualityRecordId])
  @@map("quality_measurement")
}

// A tracked follow-up on a quality problem -- separate from
// QualityDisposition, which only ever decides what happens to the rejected
// UNITS (scrap/rework/use_as_is). A corrective action tracks the ROOT-CAUSE
// response (e.g. "recalibrate machine X", "retrain operator on stage Y"),
// which may well outlive the job the triggering inspection belonged to.
// jobId is required (every corrective action is raised in the context of
// some job); qualityRecordId is optional, since a corrective action can
// also be raised generally (e.g. from a recurring pattern across jobs)
// without pointing at one specific inspection.
model CorrectiveAction {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String                 @map("org_id") @db.Uuid
  jobId            String                 @map("job_id") @db.Uuid
  job              ProductionJob          @relation(fields: [orgId, jobId], references: [orgId, id])
  qualityRecordId  String?                @map("quality_record_id") @db.Uuid
  qualityRecord    QualityRecord?         @relation(fields: [orgId, qualityRecordId], references: [orgId, id])
  description      String
  assignedToUserId String?                @map("assigned_to") @db.Uuid
  status           CorrectiveActionStatus @default(open)
  dueDate          DateTime?              @map("due_date") @db.Date
  resolvedAt       DateTime?              @map("resolved_at")
  resolutionNotes  String?                @map("resolution_notes")
  createdById      String?                @map("created_by") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@unique([orgId, id])
  @@index([jobId])
  @@index([status])
  @@map("corrective_action")
}

// ---------------------------------------------------------------------------
// MILESTONE 6 — PLASTICS MANUFACTURING VERTICAL
//
// Everything below is the plastics industry profile's concrete extension of
// the shared manufacturing core (Milestone 5's architecture principle:
// "industry-specific behaviour belongs in explicit extensions"). Every
// *write* path into these models additionally checks
// Organization.industryProfile === "plastics" (plastics-item-service.ts /
// mould-service.ts / regrind-service.ts / plastics-process-service.ts) --
// deliberately NOT a DB-level constraint, because a profile change must
// never retroactively invalidate historical rows (Milestone 5's "changing
// an organisation's profile cannot corrupt historical transactions"). Read
// paths are never profile-gated, only capability/branch-scoped, so existing
// plastics data stays fully visible even if an organization later switches
// profiles.
//
// Quality management for plastics products is NOT reimplemented here --
// Milestone 4's InspectionPlan/InspectionCharacteristic mechanism is already
// fully generic (per-item, configurable name/UOM/min/max/target), which is
// exactly what the mandate's "allow tolerances to be configured by product
// or quality plan ... do not assume every plastics product uses the same
// measurements" asks for. Building a second, plastics-specific quality
// model would duplicate working shared-core functionality, the opposite of
// this milestone's own architecture principle.
// ---------------------------------------------------------------------------

enum MouldStatus {
  available
  in_use
  maintenance
  retired
}

model Mould {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String      @map("org_id") @db.Uuid
  branchId  String      @map("branch_id") @db.Uuid
  branch    Branch      @relation(fields: [orgId, branchId], references: [orgId, id])
  code      String
  name      String
  cavityCount Int       @map("cavity_count")
  status    MouldStatus @default(available)
  // A mould's cavity geometry is cut for one product; multi-product moulds
  // are a real but rarer case this milestone does not model (see
  // IMPLEMENTATION_MANIFEST.md's known limitations) -- a single optional FK,
  // not a join table, deliberately kept proportionate to that scope.
  compatibleProductItemId String? @map("compatible_product_item_id") @db.Uuid
  compatibleProductItem   Item?   @relation(fields: [orgId, compatibleProductItemId], references: [orgId, id])
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  machineCompatibilities MouldMachineCompatibility[]
  maintenanceRecords     MouldMaintenanceRecord[]
  processDetails         PlasticsProcessDetail[]

  @@unique([orgId, id])
  @@unique([branchId, code])
  @@map("mould")
}

// Many-to-many: unlike product compatibility (one mould, cut for one
// product), several presses can genuinely share one mould when tonnage and
// platen size match, so this direction is a real join table, not a single FK.
model MouldMachineCompatibility {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  mouldId   String   @map("mould_id") @db.Uuid
  mould     Mould    @relation(fields: [orgId, mouldId], references: [orgId, id])
  machineId String   @map("machine_id") @db.Uuid
  machine   Machine  @relation(fields: [orgId, machineId], references: [orgId, id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@unique([mouldId, machineId])
  @@map("mould_machine_compatibility")
}

// Mirrors MachineMaintenanceRecord exactly (same fields, same reuse of
// MaintenanceType -- scheduled/unscheduled applies identically to tooling),
// append-only usage history being a query over this table plus
// PlasticsProcessDetail.mouldId, never a separately stored total.
model MouldMaintenanceRecord {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  mouldId       String          @map("mould_id") @db.Uuid
  mould         Mould           @relation(fields: [orgId, mouldId], references: [orgId, id])
  type          MaintenanceType
  scheduledAt   DateTime?       @map("scheduled_at")
  completedAt   DateTime?       @map("completed_at")
  notes         String?
  performedById String?         @map("performed_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@index([mouldId])
  @@map("mould_maintenance_record")
}

// 1:1 with Item. Only ever meaningful for raw_material/consumable items;
// enforced in plastics-item-service.ts, not a CHECK (itemType is on Item,
// not here, and cross-table CHECKs are avoided elsewhere in this schema too).
// blendComposition is a small, fixed-shape JSON array
// ({component: string, percentage: number}[]), validated by Zod at the
// service layer -- descriptive/record-keeping only (what this material
// SKU's own spec sheet says it's blended from), never consumption-affecting;
// actual material deduction always goes through the normal BOM/lot-issue
// path against this item's own single SKU, regardless of what it's blended
// from. There is no file-upload/attachment subsystem anywhere in this
// codebase (confirmed by inspection), so materialCertificateReference is a
// free-text reference/URL, not a stored document.
model PlasticsMaterialAttributes {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                       String   @map("org_id") @db.Uuid
  itemId                      String   @map("item_id") @db.Uuid
  item                        Item     @relation(fields: [orgId, itemId], references: [orgId, id])
  // Free text with suggested values (PET/HDPE/PP/...) offered by the
  // frontend, not a closed enum -- the mandate explicitly calls for "other
  // configured polymer grades" and "do not hardcode the system to only PET
  // bottles"; a Prisma enum would need a migration for every new grade.
  polymerGrade                String?  @map("polymer_grade")
  resinSpec                   String?  @map("resin_spec")
  colourMasterbatch           String?  @map("colour_masterbatch")
  additiveNotes               String?  @map("additive_notes")
  recycledContentPct          Decimal? @map("recycled_content_pct") @db.Decimal(5, 2)
  supplierMaterialRef         String?  @map("supplier_material_ref")
  materialCertificateReference String? @map("material_certificate_reference")
  blendComposition            Json?    @map("blend_composition")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@unique([orgId, id])
  @@unique([orgId, itemId])
  @@map("plastics_material_attributes")
}

// 1:1 with Item (finished_good/wip side). Same free-text-with-suggestions
// choice as polymerGrade above for productType -- "configurable product
// characteristics", not a fixed catalogue. otherAttributes is a small,
// UI-rendered key/value JSON bag for anything not covered by the structured
// columns (display/reference only, never read by any calculation in this
// delivery) -- a deliberately bounded escape hatch, not this model's primary
// mechanism, so it does not become the generic EAV model the mandate warns
// against.
model PlasticsProductSpec {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                     String   @map("org_id") @db.Uuid
  itemId                    String   @map("item_id") @db.Uuid
  item                      Item     @relation(fields: [orgId, itemId], references: [orgId, id])
  productType               String   @map("product_type")
  resinType                 String?  @map("resin_type")
  colour                    String?
  nominalWeightGrams        Decimal? @map("nominal_weight_grams") @db.Decimal(10, 3)
  capacityMl                Decimal? @map("capacity_ml") @db.Decimal(12, 3)
  heightMm                  Decimal? @map("height_mm") @db.Decimal(10, 2)
  diameterMm                Decimal? @map("diameter_mm") @db.Decimal(10, 2)
  neckFinish                String?  @map("neck_finish")
  closureCompatibilityNotes String?  @map("closure_compatibility_notes")
  otherAttributes           Json?    @map("other_attributes")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([orgId, id])
  @@unique([orgId, itemId])
  @@map("plastics_product_spec")
}

// 1:1 with ProductionJobStage -- the plastics-specific process detail for
// one stage of one job (which mould, which process type, target vs. actual
// cycle time, cavity performance). Mutable while the stage is active, but
// the service layer (plastics-process-service.ts) refuses further changes
// once the stage itself reaches a terminal status -- the same
// service-layer-enforced "closed means closed" discipline CorrectiveAction
// already uses (no DB trigger needed there either), not a gap relative to
// machine_time_record/quality_measurement's trigger-enforced immutability:
// those are append-only EVENT logs; this is a single result/configuration
// row per stage, same category as ProductionJobStage itself (which is also
// not trigger-immutable).
//
// actualCycleTimeSeconds is always an operator-entered figure -- there is no
// connected press/PLC telemetry anywhere in this codebase, and the mandate
// is explicit: "do not invent machine telemetry ... when no connected
// equipment provides them." The frontend labels it accordingly.
model PlasticsProcessDetail {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String   @map("org_id") @db.Uuid
  jobStageId             String   @map("job_stage_id") @db.Uuid
  jobStage               ProductionJobStage @relation(fields: [orgId, jobStageId], references: [orgId, id])
  // Free text with suggested values (injection_moulding/blow_moulding/isbm/
  // preform_production/bottle_production/cap_closure_production/...), same
  // reasoning as polymerGrade/productType above -- "represent these as
  // configurable process types ... not one hardcoded universal sequence."
  processType            String   @map("process_type")
  mouldId                String?  @map("mould_id") @db.Uuid
  mould                  Mould?   @relation(fields: [orgId, mouldId], references: [orgId, id])
  targetCycleTimeSeconds Decimal? @map("target_cycle_time_seconds") @db.Decimal(10, 2)
  actualCycleTimeSeconds Decimal? @map("actual_cycle_time_seconds") @db.Decimal(10, 2)
  totalCavities          Int?     @map("total_cavities")
  goodCavities           Int?     @map("good_cavities")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([orgId, id])
  @@unique([orgId, jobStageId])
  @@index([mouldId])
  @@map("plastics_process_detail")
}
