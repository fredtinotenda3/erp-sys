// ============================================================================
// Manufacturing Operations Intelligence Platform — Prisma schema
// Source of truth once migrations run. See ARCHITECTURE.md "Phase 0 Addendum".
//
// Prisma ORM 7: "prisma-client" generator with explicit output path and a
// driver adapter (@prisma/adapter-pg) at runtime — see src/server/shared/db.ts
// and prisma.config.ts. Application code imports from "<output>/client".
//
// All UUID primary keys use @default(dbgenerated("gen_random_uuid()")) so
// Postgres itself owns the default (matches docs/schema.sql).
//
// NOT expressible in this file (hand-written SQL migrations):
//   1. job_cost_actual.gross_profit — Postgres GENERATED column, deliberately
//      not a Prisma field (read via $queryRaw).
//   2. app_user `email = lower(email)` CHECK constraint.
//   3. Partial unique index: one ACTIVE BillOfMaterial per product.
//   4. The stock_balance-maintaining SECURITY DEFINER trigger with
//      negative-stock / currency-mixing / branch-consistency checks.
//   5. prevent_mutation immutability triggers (stock_movement, audit_log,
//      exchange_rate, job_cost_actual, and — as of migration
//      20261104110000_purchasing_and_receiving — goods_receipt and
//      goods_receipt_line) — see docs/db-roles-and-security.sql.
//   6. job_material_cost_live / job_labour_cost_live views ($queryRaw only).
//   7. goods_receipt_line CHECK constraints: quantities non-negative, and
//      accepted_qty + rejected_qty = received_qty (migration
//      20261104110000_purchasing_and_receiving).
//   8. material_lot.quantity_received > 0 CHECK, and a column-level GRANT
//      restricting mops_runtime's UPDATE on material_lot to (status,
//      expiry_date) only — every other column is set once at creation and
//      never updated (same migration as #7).
//
// Fields reorderThreshold (Item) and staleOrderThresholdDays (Organization)
// were added by migration 20261007090000 and are mirrored here.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Migrate URL lives in prisma.config.ts (mops_migrator only). The running
  // app uses RUNTIME_DATABASE_URL (mops_runtime) via src/server/shared/db.ts.
}

// ---------------------------------------------------------------------------
// IAM / TENANCY
// ---------------------------------------------------------------------------

enum Role {
  OWNER_ADMIN
  OPERATIONS_MANAGER
  PRODUCTION_MANAGER
  INVENTORY_MANAGER
  PRODUCTION_OPERATOR
  FINANCE_MANAGER
  VIEWER
}

model Organization {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  slug                    String   @unique // login handle; format CHECK is manual SQL (migration 20261008100000)
  baseCurrency            String   @map("base_currency") @db.Char(3)
  currency                Currency @relation(fields: [baseCurrency], references: [code])
  staleOrderThresholdDays Int      @default(3) @map("stale_order_threshold_days")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]
  items     Item[]
  customers Customer[]
  suppliers Supplier[]
  jobCounter JobNumberCounter?
  exchangeRates ExchangeRate[]

  @@map("organization")
}

model Branch {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  userAccess     UserBranchAccess[]
  warehouses     Warehouse[]
  productionJobs ProductionJob[]
  salesOrders    SalesOrder[]
  auditLogs      AuditLog[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([orgId, name])
  @@unique([orgId, id]) // lets children do composite FK (orgId, branchId) -> Branch(orgId, id)
  @@map("branch")
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])
  email        String // lowercased by the application; DB-enforced via manual CHECK
  passwordHash String       @map("password_hash")
  fullName     String       @map("full_name")
  role         Role
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  branchAccessGranted UserBranchAccess[] @relation("accessForUser")
  branchAccessGivenBy UserBranchAccess[] @relation("grantedByUser")
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  auditActions        AuditLog[]

  @@unique([orgId, email])
  @@unique([orgId, id])
  @@map("app_user")
}

model UserBranchAccess {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("accessForUser", fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [orgId, branchId], references: [orgId, id], onDelete: Cascade)
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid
  granter   User?    @relation("grantedByUser", fields: [grantedBy], references: [id])

  @@id([userId, branchId])
  @@map("user_branch_access")
}

// One-time password-reset credential. Only the SHA-256 of the emailed token is stored, so reading
// this table never yields a usable token. Single use (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")

  @@index([userId])
  @@map("password_reset_token")
}

// Fixed-window counters for login / reset throttling. `key` is a SHA-256 of "<scope>:<identifier>",
// so neither emails nor IP addresses are stored in the clear.
model AuthThrottle {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("auth_throttle")
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  @@map("user_session")
}

enum AuditAction {
  create
  update
  delete
  transition
  grant
  revoke
}

model AuditLog {
  id          BigInt       @id @default(autoincrement())
  orgId       String       @map("org_id") @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id])
  branchId    String?      @map("branch_id") @db.Uuid
  branch      Branch?      @relation(fields: [orgId, branchId], references: [orgId, id])
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actor       User?        @relation(fields: [orgId, actorUserId], references: [orgId, id])
  entityType  String       @map("entity_type") // intentionally free text
  entityId    String       @map("entity_id") @db.Uuid
  action      AuditAction
  beforeValue Json?        @map("before_value")
  afterValue  Json?        @map("after_value")
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// CURRENCY — platform-wide reference data, intentionally NOT org-scoped
// ---------------------------------------------------------------------------

enum RateSource {
  RBZ_OFFICIAL
  MARKET
  MANUAL
}

model Currency {
  code     String @id @db.Char(3)
  name     String
  decimals Int    @default(2)

  organizations        Organization[]
  exchangeRatesAsBase  ExchangeRate[] @relation("baseCurrency")
  exchangeRatesAsQuote ExchangeRate[] @relation("quoteCurrency")

  @@map("currency")
}

// Org-scoped: a rate is something an organization's finance team recorded and
// stands behind (source RBZ_OFFICIAL / MARKET / MANUAL). Rates are NOT shared
// between tenants -- one org's rate must never change another org's figures.
model ExchangeRate {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  org           Organization @relation(fields: [orgId], references: [id])
  baseCurrency  String     @map("base_currency") @db.Char(3)
  base          Currency   @relation("baseCurrency", fields: [baseCurrency], references: [code])
  quoteCurrency String     @map("quote_currency") @db.Char(3)
  quote         Currency   @relation("quoteCurrency", fields: [quoteCurrency], references: [code])
  rate          Decimal    @db.Decimal(18, 8)
  asOfDate      DateTime   @map("as_of_date") @db.Date
  source        RateSource
  recordedById  String?    @map("recorded_by") @db.Uuid
  recordedAt    DateTime   @default(now()) @map("recorded_at")

  @@index([orgId, baseCurrency, quoteCurrency, source, asOfDate])
  @@map("exchange_rate")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

enum ItemType {
  raw_material
  consumable
  spare_part
  finished_good
  wip
}

model Item {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String       @map("org_id") @db.Uuid
  org                  Organization @relation(fields: [orgId], references: [id])
  sku                  String
  name                 String
  description          String?
  uom                  String
  itemType             ItemType     @map("item_type")
  isSellable           Boolean      @default(false) @map("is_sellable")
  sellingPrice         Decimal?     @map("selling_price") @db.Decimal(14, 4)
  sellingPriceCurrency String?      @map("selling_price_currency") @db.Char(3)
  standardCost         Decimal?     @map("standard_cost") @db.Decimal(14, 4)
  standardCostCurrency String?      @map("standard_cost_currency") @db.Char(3)
  reorderThreshold     Decimal?     @map("reorder_threshold") @db.Decimal(14, 4)
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  bomsAsProduct        BillOfMaterial[]          @relation("productItem")
  bomLinesAsMaterial   BomLine[]                 @relation("materialItem")
  salesOrderLines      SalesOrderLine[]
  productionJobs       ProductionJob[]
  materialRequirements MaterialRequirement[]
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  stageTemplates       ProductionStageTemplate[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  materialLots         MaterialLot[]

  @@unique([orgId, sku])
  @@unique([orgId, id])
  @@map("item")
}

enum BomStatus {
  draft
  active
  superseded
}

model BillOfMaterial {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  productItemId String    @map("product_item_id") @db.Uuid
  productItem   Item      @relation("productItem", fields: [orgId, productItemId], references: [orgId, id])
  version       Int
  status        BomStatus @default(draft) // partial unique index enforces one ACTIVE per product (manual SQL)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  lines          BomLine[]
  productionJobs ProductionJob[]

  @@unique([productItemId, version])
  @@unique([orgId, id])
  @@map("bill_of_material")
}

model BomLine {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  bomId          String         @map("bom_id") @db.Uuid
  bom            BillOfMaterial @relation(fields: [orgId, bomId], references: [orgId, id], onDelete: Cascade)
  materialItemId String         @map("material_item_id") @db.Uuid
  materialItem   Item           @relation("materialItem", fields: [orgId, materialItemId], references: [orgId, id])
  quantity       Decimal        @db.Decimal(14, 4)
  uom            String

  @@index([bomId])
  @@map("bom_line")
}

// ---------------------------------------------------------------------------
// SALES — Customer is org-scoped (Q5 = org-wide)
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  inactive
}

model Customer {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  org       Organization   @relation(fields: [orgId], references: [id])
  name      String
  contact   String?
  address   String?
  status    CustomerStatus @default(active)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  salesOrders    SalesOrder[]
  productionJobs ProductionJob[]

  @@unique([orgId, id])
  @@map("customer")
}

// ---------------------------------------------------------------------------
// SUPPLIERS — first milestone of the shared-core build-out (see
// ARCHITECTURE.md's new "Shared core before industry layer" sequencing note).
// Deliberately shaped identically to Customer: org-wide master data (a vendor
// relationship isn't a branch concept — the same supplier can ship to any of
// an org's branches), no hard delete, lifecycle via `status`, no uniqueness
// constraint on name for the same reason Customer has none (two legitimate
// suppliers can share a trading name; supplier-service.test.ts asserts this
// explicitly, same as customer-service.test.ts does).
//
// Fields are intentionally minimal (name/contact/address/notes/status) —
// the same conservative slice Customer shipped with. Purchasing/PO (the next
// milestone in Stanley's ordered list) will likely need supplier-specific
// fields this slice does NOT have: payment terms, lead time, currency,
// tax/registration number, bank details. Not adding them speculatively here
// — flag when Purchasing starts whether they belong on Supplier directly or
// on the PO relationship itself.
// ---------------------------------------------------------------------------

enum SupplierStatus {
  active
  inactive
}

model Supplier {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  org       Organization   @relation(fields: [orgId], references: [id])
  name      String
  contact   String?
  address   String?
  status    SupplierStatus @default(active)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  materialLots   MaterialLot[]

  @@unique([orgId, id])
  @@map("supplier")
}

// ---------------------------------------------------------------------------
// PURCHASING — second milestone of the shared-core build-out, after Suppliers
// (ARCHITECTURE.md's "shared core before industry layer" sequencing note).
//
// Branch-scoped, not org-wide like Supplier/Customer: a PO is placed FOR
// delivery into one branch's warehouses (mirrors SalesOrder's branchId for
// the symmetric reason -- a sale ships FROM a branch, a purchase arrives
// INTO one). Numbering follows sales-order-service.ts's exact pattern
// (advisory xact lock + MAX(substring)+1 inside the create transaction) --
// no separate counter table, same choice SalesOrder made and ProductionJob
// didn't; not duplicating that decision rationale here, see that file.
//
// Status lifecycle (every value is a genuine business state with a defined
// transition, not speculative):
//   draft               -> lines are mutable; the only state that can be edited freely.
//   confirmed           -> committed to the supplier; lines frozen. Mirrors
//                          SalesOrder's confirm step and -- deliberately --
//                          reuses it as the one approval gate rather than
//                          inventing a separate multi-step chain nothing
//                          else in this codebase has (see
//                          purchase_order:confirm's capability grant below
//                          for the segregation-of-duties reasoning).
//   partially_received  -> at least one GoodsReceipt posted, outstanding qty > 0
//                          on at least one line. Set by the goods-receiving
//                          service (next milestone), never written directly here.
//   received            -> every line's outstanding qty is 0. Also set by
//                          goods-receiving, not here.
//   closed              -> manually closed after receiving is done (e.g. the
//                          supplier will never deliver the remainder) -- a
//                          deliberate terminal state distinct from "received"
//                          so a report can tell "fully delivered" apart from
//                          "we stopped waiting."
//   cancelled           -> draft or confirmed only, and only before any
//                          receipt exists (mirrors SalesOrder's "cancel
//                          blocked by live jobs" rule: cancel blocked by any
//                          real downstream activity).
//
enum PurchaseOrderStatus {
  draft
  confirmed
  partially_received
  received
  closed
  cancelled
}

// Outstanding/received quantity is deliberately NOT a stored column on
// PurchaseOrderLine -- it is computed by summing GoodsReceiptLine.acceptedQty
// (same "no duplicate source of truth" principle as StockBalance being
// trigger-derived from StockMovement, and the same choice this codebase
// already made for "why is stock what it is" -- see stock-service.ts's
// header comment). A denormalized running total would need its own
// consistency mechanism (trigger or transaction discipline) for a number
// that's already cheap to derive from the ledger of receipts.
model PurchaseOrder {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String              @map("org_id") @db.Uuid
  branchId              String              @map("branch_id") @db.Uuid
  branch                Branch              @relation(fields: [orgId, branchId], references: [orgId, id])
  poNumber              String              @map("po_number")
  supplierId            String              @map("supplier_id") @db.Uuid
  supplier              Supplier            @relation(fields: [orgId, supplierId], references: [orgId, id])
  status                PurchaseOrderStatus @default(draft)
  currency              String              @db.Char(3)
  requestedDeliveryDate DateTime?           @map("requested_delivery_date") @db.Date
  // Free-text reference to the supplier's own quote/order number -- not
  // validated against anything, same treatment as every other free-text
  // reference field in this codebase (e.g. StockMovement.reason).
  supplierReference String?  @map("supplier_reference")
  notes             String?
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([orgId, poNumber])
  @@unique([orgId, id])
  @@index([branchId, status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  poId      String        @map("po_id") @db.Uuid
  po        PurchaseOrder @relation(fields: [orgId, poId], references: [orgId, id], onDelete: Cascade)
  itemId    String        @map("item_id") @db.Uuid
  item      Item          @relation(fields: [orgId, itemId], references: [orgId, id])
  quantity  Decimal       @db.Decimal(14, 4)
  // Snapshot of the ordering unit at the time the line was written, same
  // convention as BomLine.uom / MaterialRequirement.uom -- never silently
  // re-derived from item.uom, which could change after the PO is placed.
  uom       String
  unitPrice Decimal       @map("unit_price") @db.Decimal(14, 4)
  currency  String        @db.Char(3)

  goodsReceiptLines GoodsReceiptLine[]

  @@unique([orgId, id])
  @@index([poId])
  @@map("purchase_order_line")
}

// ---------------------------------------------------------------------------
// GOODS RECEIVING — third milestone of the shared-core build-out, built
// alongside Purchasing rather than after it: a PO's "outstanding quantity"
// (section 5B requirement #17) has no referent until receipts exist, so the
// two were designed as one schema change (see IMPLEMENTATION_MANIFEST.md for
// why this reorders the mandate's own step 4/5 split without changing what
// either milestone delivers).
//
// One GoodsReceipt (header: which delivery, when, against which PO) has many
// GoodsReceiptLine rows (one per PO line received on that delivery). A single
// PO can have many receipts (partial deliveries -- requirement #18) and a
// single receipt only ever covers one PO (a delivery note that covers two
// POs is recorded as two receipts, same as a single delivery truck with two
// invoices -- keeps "which PO does this receipt close against" unambiguous).
//
// acceptedQty/rejectedQty/rejectReason mirrors QualityRecord's existing
// produced/accepted/rejected shape exactly (service layer enforces
// accepted + rejected = received, same invariant quality-service.ts already
// enforces for production inspections) -- reusing RejectReason rather than
// inventing a parallel enum for the same reason BomLine.uom etc. reuse
// existing shapes: one vocabulary, not two that can drift apart.
//
// unitCost/currency are NOT accepted from the caller -- the service derives
// them from the PO line's own unitPrice/currency (ARCHITECTURE.md's
// standing rule: never trust a client-supplied cost; see
// purchase-order-service.ts / goods-receipt-service.ts). This is receiving
// cost, which may differ from an eventual supplier invoice -- invoice
// matching is accounting/AP territory, out of scope here (FEATURE_AUDIT_MATRIX.md
// #21, already flagged as a pending decision, not reopened by this milestone).
model GoodsReceipt {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  poId              String        @map("po_id") @db.Uuid
  po                PurchaseOrder @relation(fields: [orgId, poId], references: [orgId, id])
  branchId          String        @map("branch_id") @db.Uuid
  branch            Branch        @relation(fields: [orgId, branchId], references: [orgId, id])
  deliveryReference String?       @map("delivery_reference")
  receivedAt        DateTime      @map("received_at")
  notes             String?
  // Idempotency key for the WHOLE submission (one receiving event, however
  // many lines) -- same role StockMovement.clientRequestId plays per
  // movement, but at the header level here: a retried "post this delivery"
  // request must not re-run the per-line loop (and therefore never calls
  // postMovement twice), not merely avoid a duplicate header row. Individual
  // StockMovement/MaterialLot rows created by one receipt get their own
  // fresh, server-generated ids -- they don't need their own idempotency key
  // because the header check already prevents the creating code from running
  // twice for the same logical request.
  clientRequestId String?  @map("client_request_id") @db.Uuid
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  lines GoodsReceiptLine[]

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@index([poId])
  @@index([branchId, receivedAt])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  receiptId    String            @map("receipt_id") @db.Uuid
  receipt      GoodsReceipt      @relation(fields: [orgId, receiptId], references: [orgId, id], onDelete: Cascade)
  poLineId     String            @map("po_line_id") @db.Uuid
  poLine       PurchaseOrderLine @relation(fields: [orgId, poLineId], references: [orgId, id])
  itemId       String            @map("item_id") @db.Uuid
  item         Item              @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId  String            @map("warehouse_id") @db.Uuid
  warehouse    Warehouse         @relation(fields: [orgId, warehouseId], references: [orgId, id])
  receivedQty  Decimal           @map("received_qty") @db.Decimal(14, 4)
  acceptedQty  Decimal           @map("accepted_qty") @db.Decimal(14, 4)
  rejectedQty  Decimal           @map("rejected_qty") @db.Decimal(14, 4)
  rejectReason RejectReason?     @map("reject_reason")
  // Derived from the PO line at receipt time, never client-supplied -- see
  // the model block comment above.
  unitCost  Decimal  @map("unit_cost") @db.Decimal(14, 4)
  currency  String   @db.Char(3)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  lot MaterialLot?

  @@unique([orgId, id])
  @@index([poLineId])
  @@index([receiptId])
  @@map("goods_receipt_line")
}

// ---------------------------------------------------------------------------
// LOT TRACEABILITY -- one MaterialLot per accepted GoodsReceiptLine, created
// automatically and unconditionally in the same transaction as the receipt
// (section 5F: "do not introduce lot tracking as disconnected metadata"). A
// line with acceptedQty = 0 (fully rejected) creates no lot -- there is
// nothing to trace into inventory.
//
// CONSUMPTION (as of migration 20261105120000_lot_consumption_and_traceability,
// "Phase One -- complete lot traceability"): wiring material issue/return to
// draw from and credit back to a specific lot is now built -- see
// LotConsumption below and inventory/material-issue-service.ts. Finished-
// goods batches and dispatch/customer traceability (the mandate's remaining
// forward-chain arrows) are still the NEXT milestone -- see
// IMPLEMENTATION_MANIFEST.md "Known limitations".
//
// quantityReceived is the original accepted quantity (or, for a lot spawned
// by a quarantine-flagged return -- see sourceReturnOfLotId below -- the
// returned quantity), immutable. How much of the lot remains is computed by
// summing LotConsumption rows against it, not stored here -- same "no
// duplicate source of truth" principle as StockBalance being trigger-derived
// from StockMovement: remaining = quantityReceived - SUM(LotConsumption.quantity)
// (LotConsumption.quantity is itself signed: positive = drawn from the lot,
// negative = returned to it -- see that model's comment).
//
// receiptLineId is now NULLABLE: a lot spawned by a return that needs
// inspection (see sourceReturnOfLotId) has no originating GoodsReceiptLine --
// it originates from a ProductionJob's returned material instead. Exactly
// one of (receiptLineId) or (sourceReturnOfLotId + sourceReturnJobId +
// sourceReturnMovementId) is set for any given lot; which one tells you
// whether this lot's lineage starts at a supplier delivery or at a
// production return. Not enforced as a DB CHECK (would need an OR of two
// multi-column null-groups) -- enforced by the two call sites that create a
// MaterialLot (goods-receipt-service.ts, material-issue-service.ts) never
// setting both, verified by this milestone's tests.
enum MaterialLotStatus {
  active
  quarantined
  expired
}

model MaterialLot {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  lotNumber      String           @map("lot_number")
  itemId         String           @map("item_id") @db.Uuid
  item           Item             @relation(fields: [orgId, itemId], references: [orgId, id])
  supplierId     String           @map("supplier_id") @db.Uuid
  supplier       Supplier         @relation(fields: [orgId, supplierId], references: [orgId, id])
  // What the supplier itself calls this lot/batch, if they provided one --
  // free text, not validated (mirrors PurchaseOrder.supplierReference).
  supplierLotRef String?          @map("supplier_lot_ref")
  // Nullable as of this milestone -- see the model comment above.
  receiptLineId  String?          @map("receipt_line_id") @db.Uuid
  receiptLine    GoodsReceiptLine? @relation(fields: [orgId, receiptLineId], references: [orgId, id])
  warehouseId    String           @map("warehouse_id") @db.Uuid
  warehouse      Warehouse        @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantityReceived Decimal          @map("quantity_received") @db.Decimal(14, 4)
  uom              String
  status           MaterialLotStatus @default(active)
  expiryDate       DateTime?         @map("expiry_date") @db.Date
  receivedAt       DateTime          @map("received_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  // --- Return lineage (this milestone). Set together, only when this lot was
  // spawned by a "needs inspection / quarantine" return rather than a goods
  // receipt -- see returnMaterialFromJob in material-issue-service.ts. All
  // three are set once at creation and never updated (same column-grant
  // discipline as every other immutable-after-creation column on this model).
  sourceReturnOfLotId    String?       @map("source_return_of_lot_id") @db.Uuid
  sourceReturnOfLot      MaterialLot?  @relation("LotReturnLineage", fields: [orgId, sourceReturnOfLotId], references: [orgId, id])
  returnChildLots        MaterialLot[] @relation("LotReturnLineage")
  sourceReturnJobId      String?       @map("source_return_job_id") @db.Uuid
  sourceReturnJob        ProductionJob? @relation("LotReturnJob", fields: [orgId, sourceReturnJobId], references: [orgId, id])
  sourceReturnMovementId String?       @map("source_return_movement_id") @db.Uuid
  sourceReturnMovement   StockMovement? @relation("LotReturnMovement", fields: [orgId, sourceReturnMovementId], references: [orgId, id])

  consumptions LotConsumption[]

  @@unique([orgId, lotNumber])
  @@unique([orgId, id])
  @@unique([orgId, receiptLineId])
  @@index([orgId, itemId, warehouseId])
  @@map("material_lot")
}

// Append-only usage ledger against one MaterialLot (same "one place this is
// written, never updated" discipline as StockMovement). Every row is tied 1:1
// in spirit to a slice of a StockMovement: `movementId` is the
// production_consumption or material_return movement this row is part of --
// one movement can split across several lots (one job issue drawing from
// two lots), so movementId is not unique by itself; the invariant the
// service layer enforces (and this milestone's tests verify) is that the
// LotConsumption rows sharing one movementId always sum, in absolute value,
// to that movement's own quantity.
//
// `quantity` is signed from the LOT's point of view, mirroring
// StockMovement's own sign convention: positive = drawn from the lot
// (type=consumption), negative = given back to the lot (type=return). A
// return that needs inspection does NOT create a negative row here against
// the original lot -- it spawns a new quarantined child lot instead (see
// MaterialLot.sourceReturnOfLotId) and the original consumption stands.
// remaining = quantityReceived - SUM(quantity), same formula the MaterialLot
// comment above states.
enum LotConsumptionType {
  consumption
  return
}

model LotConsumption {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  lotId       String             @map("lot_id") @db.Uuid
  lot         MaterialLot        @relation(fields: [orgId, lotId], references: [orgId, id])
  jobId       String             @map("job_id") @db.Uuid
  job         ProductionJob      @relation(fields: [orgId, jobId], references: [orgId, id])
  movementId  String             @map("movement_id") @db.Uuid
  movement    StockMovement      @relation(fields: [orgId, movementId], references: [orgId, id])
  type        LotConsumptionType
  quantity    Decimal            @db.Decimal(14, 4)
  notes       String?
  createdById String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([orgId, id])
  @@index([lotId])
  @@index([jobId])
  @@index([movementId])
  @@map("lot_consumption")
}

enum SalesOrderStatus {
  draft
  confirmed
  in_production
  partially_delivered
  delivered
  closed
  cancelled
}

model SalesOrder {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String           @map("org_id") @db.Uuid
  branchId              String           @map("branch_id") @db.Uuid
  branch                Branch           @relation(fields: [orgId, branchId], references: [orgId, id])
  orderNumber           String           @map("order_number")
  customerId            String           @map("customer_id") @db.Uuid
  customer              Customer         @relation(fields: [orgId, customerId], references: [orgId, id])
  status                SalesOrderStatus @default(draft)
  currency              String           @db.Char(3)
  requestedDeliveryDate DateTime?        @map("requested_delivery_date") @db.Date
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  lines SalesOrderLine[]

  @@unique([orgId, orderNumber])
  @@unique([orgId, id])
  @@map("sales_order")
}

model SalesOrderLine {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [orgId, salesOrderId], references: [orgId, id], onDelete: Cascade)
  itemId       String     @map("item_id") @db.Uuid
  item         Item       @relation(fields: [orgId, itemId], references: [orgId, id])
  quantity     Decimal    @db.Decimal(14, 4)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(14, 4)
  currency     String     @db.Char(3)

  productionJob ProductionJob?

  @@unique([orgId, id])
  @@map("sales_order_line")
}

// ---------------------------------------------------------------------------
// PRODUCTION
// ---------------------------------------------------------------------------

enum ProductionJobStatus {
  planned
  released
  in_progress
  on_hold
  completed
  closed
  cancelled
}

model ProductionJob {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  branch           Branch              @relation(fields: [orgId, branchId], references: [orgId, id])
  jobNumber        String              @map("job_number")
  salesOrderLineId String?             @map("sales_order_line_id") @db.Uuid
  salesOrderLine   SalesOrderLine?     @relation(fields: [orgId, salesOrderLineId], references: [orgId, id])
  customerId       String?             @map("customer_id") @db.Uuid
  customer         Customer?           @relation(fields: [orgId, customerId], references: [orgId, id])
  productItemId    String              @map("product_item_id") @db.Uuid
  productItem      Item                @relation(fields: [orgId, productItemId], references: [orgId, id])
  bomId            String              @map("bom_id") @db.Uuid
  bom              BillOfMaterial      @relation(fields: [orgId, bomId], references: [orgId, id])
  plannedQty       Decimal             @map("planned_qty") @db.Decimal(14, 4)
  plannedStart     DateTime?           @map("planned_start") @db.Date
  plannedEnd       DateTime?           @map("planned_end") @db.Date
  actualStart      DateTime?           @map("actual_start")
  actualEnd        DateTime?           @map("actual_end")
  status           ProductionJobStatus @default(planned)
  quotedAmount     Decimal?            @map("quoted_amount") @db.Decimal(14, 4)
  quotedCurrency   String?             @map("quoted_currency") @db.Char(3)
  createdById      String?             @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  materialRequirements MaterialRequirement[]
  labourRecords        LabourRecord[]
  costEstimate         JobCostEstimate?
  costEstimateLines    JobCostEstimateLine[]
  costActualLines      JobCostActualLine[]
  costActual           JobCostActual?
  costAdjustments      JobCostAdjustment[]
  stages               ProductionJobStage[]
  qualityRecords       QualityRecord[]
  outputs              ProductionOutput[]
  outputVoids          ProductionOutputVoid[]
  dispositions         QualityDisposition[]
  // Added by migration 20261105120000_lot_consumption_and_traceability.
  lotConsumptions      LotConsumption[]
  // Reverse of MaterialLot.sourceReturnJobId: quarantine lots spawned by a
  // return FROM this job (not the lots this job consumed -- see
  // lotConsumptions above and getJobLotConsumption in lot-service.ts for that).
  returnSpawnedLots    MaterialLot[]          @relation("LotReturnJob")

  @@unique([orgId, jobNumber])
  @@unique([orgId, id])
  @@unique([orgId, salesOrderLineId]) // backs the 1:1 FK above
  @@index([branchId, status])
  @@map("production_job")
}

model MaterialRequirement {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  jobId          String        @map("job_id") @db.Uuid
  job            ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id], onDelete: Cascade)
  materialItemId String        @map("material_item_id") @db.Uuid
  materialItem   Item          @relation(fields: [orgId, materialItemId], references: [orgId, id])
  expectedQty    Decimal       @map("expected_qty") @db.Decimal(14, 4)
  uom            String
  // Snapshot of the item's standard cost when the job was created. Null =
  // the item had no standard cost ("unpriced") -- never a guessed number.
  standardUnitCost         Decimal? @map("standard_unit_cost") @db.Decimal(14, 4)
  standardUnitCostCurrency String?  @map("standard_unit_cost_currency") @db.Char(3)

  @@index([jobId])
  @@map("material_requirement")
}

model LabourRecord {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  userId          String?       @map("user_id") @db.Uuid
  hours           Decimal       @db.Decimal(8, 2)
  rate            Decimal       @db.Decimal(14, 4)
  rateCurrency    String        @map("rate_currency") @db.Char(3)
  clientRequestId String?       @map("client_request_id") @db.Uuid
  recordedAt      DateTime      @default(now()) @map("recorded_at")

  @@unique([orgId, clientRequestId]) // composite, not global
  @@index([jobId])
  @@map("labour_record")
}

model ProductionStageTemplate {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  productItemId String? @map("product_item_id") @db.Uuid
  product       Item?   @relation(fields: [orgId, productItemId], references: [orgId, id])
  stageName     String  @map("stage_name")
  sequence      Int

  @@unique([orgId, id])
  @@map("production_stage_template")
}

enum ProductionJobStageStatus {
  pending
  in_progress
  completed
}

model ProductionJobStage {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String                   @map("org_id") @db.Uuid
  jobId           String                   @map("job_id") @db.Uuid
  job             ProductionJob            @relation(fields: [orgId, jobId], references: [orgId, id], onDelete: Cascade)
  stageName       String                   @map("stage_name")
  sequence        Int
  status          ProductionJobStageStatus @default(pending)
  startedAt       DateTime?                @map("started_at")
  completedAt     DateTime?                @map("completed_at")
  operatorUserId  String?                  @map("operator_user_id") @db.Uuid
  qtyProcessed    Decimal?                 @map("qty_processed") @db.Decimal(14, 4)
  qtyRejected     Decimal?                 @map("qty_rejected") @db.Decimal(14, 4)
  notes           String?
  clientRequestId String?                  @map("client_request_id") @db.Uuid
  // Phase 3
  plannedStart       DateTime? @map("planned_start")
  plannedEnd         DateTime? @map("planned_end")
  workCentre         String?   @map("work_centre")
  requiresInspection Boolean   @default(false) @map("requires_inspection")
  blockedReason      String?   @map("blocked_reason")
  blockedAt          DateTime? @map("blocked_at")
  blockedById        String?   @map("blocked_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  qualityRecords QualityRecord[]
  outputs        ProductionOutput[]

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@unique([jobId, sequence])
  @@map("production_job_stage")
}

enum RejectReason {
  wrong_dimensions
  damaged
  paint_defect
  missing_component
  other
}

model QualityRecord {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String              @map("org_id") @db.Uuid
  jobId           String              @map("job_id") @db.Uuid
  job             ProductionJob       @relation(fields: [orgId, jobId], references: [orgId, id])
  jobStageId      String?             @map("job_stage_id") @db.Uuid
  jobStage        ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  producedQty     Decimal             @map("produced_qty") @db.Decimal(14, 4)
  acceptedQty     Decimal             @map("accepted_qty") @db.Decimal(14, 4)
  rejectedQty     Decimal             @map("rejected_qty") @db.Decimal(14, 4)
  rejectReason    RejectReason?       @map("reject_reason")
  notes           String?
  evidenceRef     String?             @map("evidence_ref")
  clientRequestId String?             @map("client_request_id") @db.Uuid
  recordedAt      DateTime            @default(now()) @map("recorded_at")
  // Phase 3: an inspection RESULT. produced_qty = units inspected;
  // accepted + rejected = produced; outcome = 'pass' iff nothing rejected.
  inspectorUserId String?             @map("inspector_user_id") @db.Uuid
  outcome         String?
  uom             String?

  dispositions QualityDisposition[]
  outputs      ProductionOutput[]

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@map("quality_record")
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model Warehouse {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  branch   Branch  @relation(fields: [orgId, branchId], references: [orgId, id])
  name     String
  isActive Boolean @default(true) @map("is_active")

  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  goodsReceiptLines GoodsReceiptLine[]
  materialLots      MaterialLot[]

  @@unique([branchId, name])
  @@unique([orgId, id])
  @@map("warehouse")
}

enum MovementType {
  purchase_receipt
  material_issue
  material_return
  production_consumption
  finished_goods_receipt
  sale_delivery
  adjustment
  stock_transfer_out
  stock_transfer_in
}

enum ReferenceType {
  production_job
  purchase_order
  sales_order
  manual
}

model StockMovement {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid // denormalized from warehouse.branchId, validated by trigger
  itemId          String         @map("item_id") @db.Uuid
  item            Item           @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId     String         @map("warehouse_id") @db.Uuid
  warehouse       Warehouse      @relation(fields: [orgId, warehouseId], references: [orgId, id])
  movementType    MovementType   @map("movement_type")
  quantity        Decimal        @db.Decimal(14, 4) // signed
  unitCost        Decimal?       @map("unit_cost") @db.Decimal(14, 4) // required on receipts; system-stamped on consumption
  currency        String?        @db.Char(3)
  referenceType   ReferenceType? @map("reference_type")
  referenceId     String?        @map("reference_id") @db.Uuid
  reason          String?
  clientRequestId String?        @map("client_request_id") @db.Uuid
  createdById     String?        @map("created_by") @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  syncedAt        DateTime       @default(now()) @map("synced_at")

  // Added by migration 20261105120000_lot_consumption_and_traceability so
  // MaterialLot/LotConsumption rows can carry a composite (orgId, movementId)
  // FK back to the exact movement they were created from or returned against
  // -- same org-isolation-at-the-constraint-level convention every other
  // relation in this schema already uses, not previously needed because
  // nothing referenced a StockMovement row before this milestone.
  lotConsumptions LotConsumption[]
  lotsReturnedFrom MaterialLot[]  @relation("LotReturnMovement")

  @@unique([orgId, clientRequestId])
  @@unique([orgId, id])
  @@index([itemId, warehouseId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movement")
}

// Written ONLY by the trg_stock_movement_before_insert trigger (SECURITY
// DEFINER). Never call prisma.stockBalance.create/update/upsert; reads only.
model StockBalance {
  orgId                   String    @map("org_id") @db.Uuid
  itemId                  String    @map("item_id") @db.Uuid
  item                    Item      @relation(fields: [orgId, itemId], references: [orgId, id])
  warehouseId             String    @map("warehouse_id") @db.Uuid
  warehouse               Warehouse @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantity                Decimal   @default(0) @db.Decimal(14, 4)
  averageUnitCost         Decimal?  @map("average_unit_cost") @db.Decimal(14, 4)
  averageUnitCostCurrency String?   @map("average_unit_cost_currency") @db.Char(3)
  updatedAt               DateTime  @default(now()) @map("updated_at")

  @@id([itemId, warehouseId])
  @@map("stock_balance")
}

// ---------------------------------------------------------------------------
// COSTING
// ---------------------------------------------------------------------------

// Header only. Amounts live in JobCostEstimateLine, one row per currency, so an
// estimate can never silently mix currencies. unpricedMaterials lists the
// materials that could not be priced and why:
//   [{ materialItemId, reason: "no_standard_cost" | "uom_mismatch" }]
model JobCostEstimate {
  orgId             String        @map("org_id") @db.Uuid
  jobId             String        @id @map("job_id") @db.Uuid
  job               ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  unpricedMaterials Json          @default("[]") @map("unpriced_materials")
  computedAt        DateTime      @default(now()) @map("computed_at")

  @@unique([orgId, jobId])
  @@map("job_cost_estimate")
}

model JobCostEstimateLine {
  orgId                 String        @map("org_id") @db.Uuid
  jobId                 String        @map("job_id") @db.Uuid
  job                   ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency              String        @db.Char(3)
  estimatedMaterialCost Decimal       @map("estimated_material_cost") @db.Decimal(14, 4)
  estimatedLabourCost   Decimal?      @map("estimated_labour_cost") @db.Decimal(14, 4)
  estimatedOverheadCost Decimal?      @map("estimated_overhead_cost") @db.Decimal(14, 4)

  @@id([jobId, currency])
  @@map("job_cost_estimate_line")
}

// One row per organization; incremented inside the job-creation transaction.
model JobNumberCounter {
  orgId      String       @id @map("org_id") @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  lastNumber Int          @default(0) @map("last_number")

  @@map("job_number_counter")
}

// Completion snapshot, written ONCE when a job completes and never changed
// (DB immutability trigger). Header = revenue basis (the job's quote at
// completion); amounts live in JobCostActualLine, one row per currency, so an
// actual cost can never silently mix currencies. Gross profit is derived on
// read (only when all cost is in the revenue currency), never stored.
model JobCostActual {
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @id @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  revenue         Decimal?      @db.Decimal(14, 4)
  revenueCurrency String?       @map("revenue_currency") @db.Char(3)
  snapshottedAt   DateTime      @default(now()) @map("snapshotted_at")
  // What was and was not known at completion (missing components, unpriced
  // materials...) and which records were counted. Frozen with the snapshot.
  // {"legacy": true} marks snapshots written before these columns existed.
  completeness    Json          @default("{\"legacy\": true}")
  evidence        Json          @default("{}")

  @@unique([orgId, jobId])
  @@map("job_cost_actual")
}

model JobCostActualLine {
  orgId              String        @map("org_id") @db.Uuid
  jobId              String        @map("job_id") @db.Uuid
  job                ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency           String        @db.Char(3)
  actualMaterialCost Decimal       @map("actual_material_cost") @db.Decimal(14, 4)
  // null = no labour was recorded in this currency (not "zero").
  actualLabourCost   Decimal?      @map("actual_labour_cost") @db.Decimal(14, 4)
  // null = unavailable until an overhead allocation method is approved.
  actualOverheadCost Decimal?      @map("actual_overhead_cost") @db.Decimal(14, 4)

  @@id([jobId, currency])
  @@map("job_cost_actual_line")
}

// Explicit, append-only correction to a FROZEN job cost. The snapshot is never
// edited; effective actual cost = snapshot + adjustments. Only against a job
// that has a snapshot (DB trigger), always with a reason (>= 10 chars).
model JobCostAdjustment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  currency        String        @db.Char(3)
  component       String // "material" | "labour" (CHECK in the database)
  amount          Decimal       @db.Decimal(14, 4)
  reason          String
  clientRequestId String?       @map("client_request_id") @db.Uuid
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([orgId, clientRequestId])
  @@index([jobId])
  @@map("job_cost_adjustment")
}

// ---------------------------------------------------------------------------
// SHOP FLOOR (Phase 3). All append-only; see migration 20261022100000.
// ---------------------------------------------------------------------------

// Good / scrap / rework quantities recorded against a job (and stage).
model ProductionOutput {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                   String              @map("org_id") @db.Uuid
  jobId                   String              @map("job_id") @db.Uuid
  job                     ProductionJob       @relation(fields: [orgId, jobId], references: [orgId, id])
  jobStageId              String?             @map("job_stage_id") @db.Uuid
  jobStage                ProductionJobStage? @relation(fields: [orgId, jobStageId], references: [orgId, id])
  goodQty                 Decimal             @default(0) @map("good_qty") @db.Decimal(14, 4)
  scrapQty                Decimal             @default(0) @map("scrap_qty") @db.Decimal(14, 4)
  reworkQty               Decimal             @default(0) @map("rework_qty") @db.Decimal(14, 4)
  reworkGoodQty           Decimal             @default(0) @map("rework_good_qty") @db.Decimal(14, 4)
  reworkScrapQty          Decimal             @default(0) @map("rework_scrap_qty") @db.Decimal(14, 4)
  reclassifiedFromGoodQty Decimal             @default(0) @map("reclassified_from_good_qty") @db.Decimal(14, 4)
  uom                     String
  reason                  RejectReason?
  notes                   String?
  source                  String              @default("operator")
  inspectionId            String?             @map("inspection_id") @db.Uuid
  inspection              QualityRecord?      @relation(fields: [orgId, inspectionId], references: [orgId, id])
  operatorUserId          String?             @map("operator_user_id") @db.Uuid
  recordedAt              DateTime            @default(now()) @map("recorded_at")
  clientRequestId         String?             @map("client_request_id") @db.Uuid

  void ProductionOutputVoid?

  @@unique([orgId, id])
  @@unique([orgId, clientRequestId])
  @@index([jobId])
  @@map("production_output")
}

// A reasoned reversal of one output entry. The entry itself is never edited.
model ProductionOutputVoid {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String           @map("org_id") @db.Uuid
  jobId    String           @map("job_id") @db.Uuid
  job      ProductionJob    @relation(fields: [orgId, jobId], references: [orgId, id])
  outputId String           @map("output_id") @db.Uuid
  output   ProductionOutput @relation(fields: [orgId, outputId], references: [orgId, id])
  reason   String
  voidedBy String?          @map("voided_by") @db.Uuid
  voidedAt DateTime         @default(now()) @map("voided_at")

  @@unique([orgId, outputId])
  @@map("production_output_void")
}

// An authorised decision on rejected units of one inspection.
model QualityDisposition {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  job             ProductionJob @relation(fields: [orgId, jobId], references: [orgId, id])
  inspectionId    String        @map("inspection_id") @db.Uuid
  inspection      QualityRecord @relation(fields: [orgId, inspectionId], references: [orgId, id])
  kind            String // scrap | rework | use_as_is (CHECK in the database)
  qty             Decimal       @db.Decimal(14, 4)
  reason          String
  decidedBy       String        @map("decided_by") @db.Uuid
  decidedAt       DateTime      @default(now()) @map("decided_at")
  clientRequestId String?       @map("client_request_id") @db.Uuid

  @@unique([orgId, clientRequestId])
  @@index([inspectionId])
  @@map("quality_disposition")
}
